---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

export interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<section class="bg-primary px-4 py-20 md:px-8 lg:px-16 lg:py-28">
  <div class="">
    <p class="font-mono text-sm uppercase tracking-widest text-gray-400">{t("process.eyebrow")}</p>
    <h4 class="mt-4 max-w-3xl font-unbounded text-xl font-bold uppercase leading-tight text-black md:text-4xl">{t("process.title")}</h4>
    <div class="mt-10 flex flex-col gap-3 lg:gap-16 md:flex-row">
      {(["one", "two", "three"] as const).map((step, index) => (
        <article class="border-t border-gray-400 pt-5">
          <p class="font-mono text-sm text-primary">0{index + 1}</p>
          <h5 class="mt-4 font-unbounded text-lg font-bold uppercase text-black">{t(`process.${step}Title`)}</h5>
          <p class="mt-3 font-albert text-lg leading-relaxed text-gray-800">{t(`process.${step}Text`)}</p>
        </article>
      ))}
    </div>
  </div>
</section>
