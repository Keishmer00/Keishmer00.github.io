---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<theme-controller class="inline-flex" data-label={t("theme.label")}>
  <div
    class="flex items-center gap-1 rounded-full border border-border-subtle bg-surface-muted p-1"
    role="group"
    aria-label={t("theme.label")}
  >
    <button
      type="button"
      data-theme-choice="system"
      aria-pressed="false"
      aria-label={t("theme.switchToSystem")}
      class="flex items-center gap-1.5 rounded-full px-3 py-1.5 font-mono text-base uppercase tracking-wider text-text-secondary transition-colors hover:text-text-primary md:text-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor" aria-hidden="true"><path d="M480-80q-75 0-140.5-28.5t-114-77q-48.5-48.5-77-114T120-440q0-75 28.5-140.5t77-114q48.5-48.5 114-77T480-800q75 0 140.5 28.5t114 77q48.5 48.5 77 114T840-440q0 75-28.5 140.5t-77 114q-48.5 48.5-114 77T480-80Zm0-80q117 0 198.5-81.5T760-440q0-117-81.5-198.5T480-720q-117 0-198.5 81.5T200-440q0 117 81.5 198.5T480-160Zm0-120q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47Z"/></svg>
      <span>{t("theme.system")}</span>
    </button>
    <button
      type="button"
      data-theme-choice="light"
      aria-pressed="false"
      aria-label={t("theme.switchToLight")}
      class="flex items-center gap-1.5 rounded-full px-3 py-1.5 font-mono text-base uppercase tracking-wider text-text-secondary transition-colors hover:text-text-primary md:text-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor" aria-hidden="true"><path d="M480-360q50 0 85-35t35-85q0-50-35-85t-85-35q-50 0-85 35t-35 85q0 50 35 85t85 35Zm0 80q-83 0-141.5-58.5T280-480q0-83 58.5-141.5T480-680q83 0 141.5 58.5T680-480q0 83-58.5 141.5T480-280ZM200-440H40v-80h160v80Zm720 0H760v-80h160v80ZM440-760v-160h80v160h-80Zm0 720v-160h80v160h-80ZM256-662l-101-97 57-59 96 100-52 56Zm492 496-97-101 53-55 101 97-57 59Zm-99-537 97-101 59 57-101 97-55-53ZM154-212l101-97 55 53-97 101-59-57Z"/></svg>
      <span>{t("theme.light")}</span>
    </button>
    <button
      type="button"
      data-theme-choice="dark"
      aria-pressed="false"
      aria-label={t("theme.switchToDark")}
      class="flex items-center gap-1.5 rounded-full px-3 py-1.5 font-mono text-base uppercase tracking-wider text-text-secondary transition-colors hover:text-text-primary md:text-lg"
    >
      <svg xmlns="http://www.w3.org/2000/svg" height="18px" viewBox="0 -960 960 960" width="18px" fill="currentColor" aria-hidden="true"><path d="M480-120q-150 0-255-105T120-480q0-150 105-255t255-105q14 0 27.5 1t26.5 3q-41 29-65.5 75.5T444-660q0 90 63 153t153 63q55 0 101-24.5t75-65.5q2 13 3 26.5t1 27.5q0 150-105 255T480-120Zm0-80q88 0 158-48.5T740-375q-20 5-40 8t-40 3q-123 0-209.5-86.5T364-660q0-20 3-40t8-40q-78 32-126.5 102T200-480q0 116 82 198t198 82Zm-10-270Z"/></svg>
      <span>{t("theme.dark")}</span>
    </button>
  </div>
</theme-controller>

<script>
  type ThemePreference = 'system' | 'light' | 'dark';

  class ThemeController extends HTMLElement {
    private cleanup: (() => void) | null = null;
    private updateActive: (raw: ThemePreference) => void = () => {};

    connectedCallback() {
      const STORAGE_KEY = 'keishmer-theme';
      const getRaw = (): 'system' | 'light' | 'dark' => {
        try {
          const value = localStorage.getItem(STORAGE_KEY);
          if (value === 'light' || value === 'dark') return value;
        } catch {}
        return 'system';
      };
      const setRaw = (value: 'system' | 'light' | 'dark') => {
        try { localStorage.setItem(STORAGE_KEY, value); } catch {}
      };
      const getEffective = (raw: 'system' | 'light' | 'dark'): 'light' | 'dark' => {
        if (raw === 'light' || raw === 'dark') return raw;
        return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
      };
      const updateMeta = (effective: 'light' | 'dark') => {
        const color = effective === 'light' ? '#F2F4FF' : '#121314';
        // Cambia el `content` de TODAS las metas existentes (Safari/iOS no detecta metas nuevas).
        const metas = document.querySelectorAll('meta[name="theme-color"]');
        if (!metas.length) {
          const meta = document.createElement('meta');
          meta.setAttribute('name', 'theme-color');
          meta.setAttribute('content', color);
          document.head.appendChild(meta);
          return;
        }
        metas.forEach((meta) => {
          meta.removeAttribute('media');
          meta.setAttribute('content', color);
        });
      };
      const apply = (raw: 'system' | 'light' | 'dark') => {
        const effective = getEffective(raw);
        document.documentElement.dataset.theme = effective;
        updateMeta(effective);
        // `preference` lets other <theme-controller> instances (navbar, /brand/) stay in sync.
        window.dispatchEvent(new CustomEvent('keishmer:theme-change', { detail: { theme: effective, preference: raw } }));
        this.updateActive(raw);
      };

      const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>('[data-theme-choice]'));
      this.updateActive = (raw) => {
        buttons.forEach((btn) => {
          const active = btn.dataset.themeChoice === raw;
          btn.setAttribute('aria-pressed', String(active));
          btn.classList.toggle('bg-surface-primary', active);
          btn.classList.toggle('text-text-on-primary', active);
          btn.classList.toggle('text-text-secondary', !active);
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const raw = btn.dataset.themeChoice as 'system' | 'light' | 'dark';
          setRaw(raw);
          apply(raw);
        });
      });

      const mql = window.matchMedia('(prefers-color-scheme: light)');
      const onSystemChange = () => {
        if (getRaw() === 'system') apply('system');
      };
      mql.addEventListener('change', onSystemChange);

      const onThemeChange = (event: Event) => {
        const preference = (event as CustomEvent<{ preference?: ThemePreference }>).detail?.preference;
        if (preference) this.updateActive(preference);
      };
      window.addEventListener('keishmer:theme-change', onThemeChange);

      // The inline script in Layout already painted the right theme; only sync the UI here.
      this.updateActive(getRaw());

      this.cleanup = () => {
        mql.removeEventListener('change', onSystemChange);
        window.removeEventListener('keishmer:theme-change', onThemeChange);
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = null;
    }
  }

  if (!customElements.get('theme-controller')) {
    customElements.define('theme-controller', ThemeController);
  }
</script>
