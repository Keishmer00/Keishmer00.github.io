---
import type { Lang } from "../i18n/index";
import { getLocalizedPath, useTranslations } from "../i18n/index";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);
const localizedPrivacy = getLocalizedPath("/privacy/", lang);
const localizedTerms = getLocalizedPath("/terms/", lang);
---

<section id="contact" class="flex w-full items-center justify-center bg-black px-4 py-16 md:p-14 lg:px-16 lg:py-20">
  <div class="flex w-full  flex-col items-center justify-center border border-gray-300 bg-linear-to-br from-white/5 via-black to-white/5 px-6 py-10 md:px-10 md:py-12 lg:px-14 lg:py-16">
    <header class="mb-10 flex w-full max-w-3xl flex-col items-center justify-center text-center md:mb-12">
      <h6 class="font-unbounded text-2xl font-bold uppercase leading-tight tracking-tight text-white md:text-3xl">{t("form.title")}</h6>
      <p class="mt-3 font-mono text-sm font-light leading-relaxed text-gray-300 md:text-base">{t("form.description")}</p>
    </header>

    <form id="users-form" data-analytics-form data-lang={lang} 
    class="grid w-full max-w-5xl gap-x-32 gap-y-5 md:grid-cols-2">
      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.name")}</span>
        <input type="text" name="legal_name" autocomplete="name" required maxlength="100" class="bg-transparent text-sm text-white outline-none placeholder:text-white/40 md:text-base" />
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.email")}</span>
        <input type="email" name="client_email" autocomplete="email" required maxlength="100" class="bg-transparent text-sm text-white outline-none placeholder:text-white/40 md:text-base" />
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.phone")}</span>
        <input type="tel" name="phone_number" autocomplete="tel" maxlength="30" class="bg-transparent text-sm text-white outline-none placeholder:text-white/40 md:text-base" />
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.projectType")}</span>
        <select name="project_type" required class="bg-black text-sm text-white outline-none md:text-base">
          <option value="" disabled selected>{t("form.projectTypePlaceholder")}</option>
          <option value="ux-ui">{t("form.projectTypeUx")}</option>
          <option value="web-frontend">{t("form.projectTypeWeb")}</option>
          <option value="branding">{t("form.projectTypeBranding")}</option>
          <option value="ongoing-support">{t("form.projectTypeSupport")}</option>
        </select>
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.budget")}</span>
        <select name="budget_range" required class="bg-black text-sm text-white outline-none md:text-base">
          <option value="" disabled selected>{t("form.budgetPlaceholder")}</option>
          <option value="under-1000">{t("form.budgetUnder")}</option>
          <option value="1000-3000">{t("form.budgetOneThree")}</option>
          <option value="over-3000">{t("form.budgetOver")}</option>
        </select>
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.timeline")}</span>
        <select name="timeline" required class="bg-black text-sm text-white outline-none md:text-base">
          <option value="" disabled selected>{t("form.timelinePlaceholder")}</option>
          <option value="asap">{t("form.timelineNow")}</option>
          <option value="within-month">{t("form.timelineMonth")}</option>
          <option value="one-to-three-months">{t("form.timelineLater")}</option>
          <option value="exploring">{t("form.timelineExploring")}</option>
        </select>
      </label>

      <label class="flex flex-col gap-2 border-b border-white/25 pb-2 md:col-span-2">
        <span class="text-[10px] font-bold uppercase tracking-widest text-white">{t("form.message")}</span>
        <textarea name="message" required maxlength="3000" rows="5" class="resize-y bg-transparent text-sm text-white outline-none placeholder:text-white/40 md:text-base"></textarea>
      </label>

      <div id="form-status" role="status" aria-live="polite" class="hidden text-sm font-medium md:col-span-2"></div>

      <div class="flex flex-col gap-4 pt-4 mx-auto w-full">
        <button type="submit" id="submit-btn" class="flex w-full items-center justify-between gap-3 bg-white px-4 py-2 font-mono text-xl text-black transition-colors duration-300 hover:bg-primary hover:text-white md:px-6 md:py-4">
          <span id="submit-text">{t("form.submit")}</span>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-brand-tertiary"><svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="currentColor"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg></span>
        </button>
        <p class="text-center font-mono text-[10px] leading-relaxed text-gray-400 md:text-left">
          <a href={localizedPrivacy} class="text-white hover:underline">{t("form.privacy")}</a>
          · <a href={localizedTerms} class="text-white hover:underline">{t("form.terms")}</a>.
          {" "}{t("form.recaptcha")}
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  declare const grecaptcha: {
    ready: (callback: () => void) => void;
    execute: (siteKey: string, options: { action: string }) => Promise<string>;
  };

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.querySelector<HTMLFormElement>("#users-form");
    if (!form) return;

    const submitButton = form.querySelector<HTMLButtonElement>("#submit-btn");
    const submitText = form.querySelector<HTMLElement>("#submit-text");
    const status = form.querySelector<HTMLElement>("#form-status");
    if (!submitButton || !submitText || !status) return;

    const setStatus = (message: string, type: "success" | "error") => {
      status.textContent = message;
      status.className = `text-sm font-medium md:col-span-2 ${type === "success" ? "text-green-400" : "text-red-400"}`;
    };

    const loadRecaptcha = () => new Promise<void>((resolve, reject) => {
      if (typeof grecaptcha !== "undefined") {
        resolve();
        return;
      }
      const script = document.createElement("script");
      script.src = `https://www.google.com/recaptcha/api.js?render=${import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY}`;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error("reCAPTCHA unavailable"));
      document.head.appendChild(script);
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      submitButton.disabled = true;
      submitText.textContent = "Sending...";
      status.classList.add("hidden");

      try {
        await loadRecaptcha();
        const token = await new Promise<string>((resolve, reject) => {
          if (typeof grecaptcha === "undefined") {
            reject(new Error("reCAPTCHA unavailable"));
            return;
          }
          grecaptcha.ready(() => {
            grecaptcha.execute(import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY, { action: "submit" }).then(resolve).catch(reject);
          });
        });

        const values = Object.fromEntries(new FormData(form).entries());
        const url = new URL(window.location.href);
        const payload = {
          ...values,
          language: form.dataset.lang || (window.location.pathname.startsWith("/es/") ? "es" : "en"),
          source_path: window.location.pathname,
          referrer: document.referrer || null,
          utm_source: url.searchParams.get("utm_source"),
          utm_medium: url.searchParams.get("utm_medium"),
          utm_campaign: url.searchParams.get("utm_campaign"),
          recaptcha: token,
        };

        const response = await fetch("/api/submit-clients", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (!response.ok || !result.success) throw new Error(result.message || "Request failed");

        form.reset();
        setStatus(result.message, "success");
        window.dispatchEvent(new CustomEvent("keishmer:form-success"));
      } catch (error) {
        console.error("Form submission failed", error);
        setStatus("Something went wrong. Please try again or email kshmr044@gmail.com.", "error");
      } finally {
        status.classList.remove("hidden");
        submitButton.disabled = false;
        submitText.textContent = form.dataset.lang === "es" ? "Enviar consulta" : "Send project inquiry";
      }
    });
  });
</script>
