---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";

export interface Props { lang: Lang }
const { lang } = Astro.props;
const { t } = useTranslations(lang);
---

<aside id="consent-banner" class="fixed bottom-4 left-4 right-4 z-[100] hidden border border-border-subtle bg-surface-default/95 p-4 shadow-2xl md:left-auto md:max-w-md">
  <p class="font-mono text-xs leading-relaxed text-text-secondary">{t("consent.text")}</p>
  <div class="mt-4 flex gap-3">
    <button id="consent-accept" class="bg-surface-inverse px-3 py-2 font-mono text-xs uppercase text-text-inverse hover:bg-surface-primary hover:text-text-on-primary">{t("consent.accept")}</button>
    <button id="consent-decline" class="border border-border-default px-3 py-2 font-mono text-xs uppercase text-text-primary hover:border-text-primary">{t("consent.decline")}</button>
  </div>
</aside>

<script is:inline>
  const banner = document.getElementById("consent-banner");
  const storedConsent = localStorage.getItem("keishmer-analytics-consent");
  if (!storedConsent && banner) banner.classList.remove("hidden");

  const setConsent = (value) => {
    localStorage.setItem("keishmer-analytics-consent", value);
    banner?.classList.add("hidden");
    window.dispatchEvent(new CustomEvent("keishmer:analytics-consent", { detail: value }));
  };

  document.getElementById("consent-accept")?.addEventListener("click", () => setConsent("accepted"));
  document.getElementById("consent-decline")?.addEventListener("click", () => setConsent("declined"));
</script>
