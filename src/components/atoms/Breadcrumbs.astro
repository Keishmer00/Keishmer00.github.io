---

export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
  class?: string;
  light?: boolean;
}

const { items, class: className = "",  light = false } = Astro.props;

const linkClass = light
  ? "text-text-secondary hover:text-text-accent transition-colors font-bold"
  : "text-text-accent hover:text-text-accent transition-colors";

const separatorClass = light ? "text-text-muted" : "opacity-50 text-text-accent/50";

const currentClass = light ? "text-text-accent font-bold" : "text-text-accent font-bold";
---

<div class={`absolute z-50 w-fit mx-4 md:mx-52 lg:mx-64 pt-16 md:pt-6 ${className}`}>
    <nav aria-label="Breadcrumb" class="flex text-[11px] md:text-xs font-medium tracking-widest uppercase">
    <ol class="flex items-center gap-2">
      {items.map((item, index) => (
        <>
          {index > 0 && <li><span class={separatorClass}>/</span></li>}
          <li>
            {item.href ? (
              <a href={item.href} class={linkClass}>{item.label}</a>
            ) : (
              <span class={currentClass}>{item.label}</span>
            )}
          </li>
        </>
      ))}
    </ol>
  </nav>
</div>

{items.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": items.map((item, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "name": item.label,
      ...(item.href ? { "item": `https://keishmerstudio.com${item.href}` } : {}),
    })),
  })} />
)}