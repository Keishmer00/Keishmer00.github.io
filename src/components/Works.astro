---
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";
import { getCategories, getProjectUrl } from "../lib/projects";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const categories = getCategories(lang).map((category) => ({
  id: category.id,
  label: category.label,
  statement: category.statement,
  works: category.works.map((work) => ({
    id: work.id,
    title: work.title,
    description: work.tagline,
    image: work.image,
    imageAlt: work.imageAlt,
    ctaLabel: work.ctaLabel,
    href: getProjectUrl(category.id, work.id, lang),
  })),
}));

const defaultCategoryIndex = 0;
---

<works-section
  id="works"
  class="flex w-full justify-between bg-black pt-12 pb-12 h-svh lg:h-auto px-8 md:px-6 lg:px-16 selection:bg-brand-primary selection:text-white"
>
  <div class="w-full mx-auto flex flex-col justify-between h-full">
    <h2
      data-works-title
      class="text-xl md:text-2xl text-left lg:text-2xl font-medium uppercase font-unbounded text-white pb-2"
    >
      {t("works.title")}
    </h2>

    <!-- Statements rendered in HTML; visibility toggled by JS. -->
    <div data-works-statements aria-live="polite" class="pb-8">
      {
        categories.map((category, index) => (
          <p
            class="text-base font-medium font-albert text-left md:text-center text-gray-300 leading-relaxed"
            hidden={index !== defaultCategoryIndex}
          >
            {category.statement}
          </p>
        ))
      }
    </div>

    <div
      class="flex flex-col-reverse lg:items-start h-[80%] lg:h-full justify-between gap-16 lg:gap-10 xl:gap-14"
    >
      <!-- Categories -->
      <article class="flex flex-col justify-between md:mx-auto shrink-0 order-1 md:order-2">
        <div class="flex flex-col gap-2 md:gap-5 w-full">
          <div
            data-works-tablist
            role="tablist"
            aria-orientation="horizontal"
            aria-label="Work categories"
            class="flex flex-row justify-between items-center w-auto gap-0 lg:gap-4 p-1"
          >
            {
              categories.map((category, index) => {
                const isActive = index === defaultCategoryIndex;
                return (
                  <button
                    type="button"
                    role="tab"
                    id={`works-tab-${category.id}`}
                    aria-selected={isActive ? "true" : "false"}
                    aria-controls={`works-panel-${category.id}`}
                    tabindex={isActive ? 0 : -1}
                    data-category-index={index}
                    class={`category-tab shrink-0 text-base font-mono transition-all duration-300 ease-out px-2 lg:px-4 max-lg:py-1.5 lg:py-2 lg:text-right uppercase ${
                      isActive
                        ? "is-active bg-white text-black"
                        : "text-gray-300 hover:text-white"
                    }`}
                  >
                    {category.label}
                  </button>
                );
              })
            }
          </div>
        </div>
      </article>

      <!-- One tabpanel per category, rendered in the HTML. No card is ever mutated. -->
      {
        categories.map((category, categoryIndex) => (
          <div
            class="works-panel flex-1 h-auto justify-between min-w-0 order-2 lg:order-1 max-lg:overflow-x-hidden"
            role="tabpanel"
            id={`works-panel-${category.id}`}
            aria-labelledby={`works-tab-${category.id}`}
            hidden={categoryIndex !== defaultCategoryIndex}
          >
            <div
              data-works-grid
              class="flex flex-row h-full lg:h-auto max-lg:overflow-x-auto max-lg:gap-4 max-lg:pb-3 max-lg:snap-x max-lg:snap-mandatory max-lg:[&::-webkit-scrollbar]:hidden max-lg:[-ms-overflow-style:none] max-lg:scrollbar-none lg:grid lg:grid-cols-4 xl:grid-cols-4 lg:gap-5 xl:gap-6"
            >
              {category.works.map((work, index) => (
                <article
                  data-work-index={index}
                  class="work-card flex flex-col min-w-0 max-lg:shrink-0 max-lg:w-[65vw] max-lg:snap-center h-full lg:max-h-[55vh]"
                >
                  <div class="work-image-wrap flex flex-col w-full overflow-hidden bg-black h-full hover:shadow-lg transition-all duration-300">
                    <img
                      src={work.image}
                      alt={work.imageAlt}
                      width="400"
                      height="500"
                      loading="lazy"
                      decoding="async"
                      class="work-image w-full flex-1 object-cover grayscale"
                    />
                    <div class="py-4 flex flex-col gap-2 bg-black">
                      <h3 class="work-title text-sm md:text-base font-bold font-unbounded uppercase tracking-wide text-white leading-tight">
                        {work.title}
                      </h3>
                      <p class="work-desc text-sm text-gray-300 block font-light font-albert leading-relaxed line-clamp-2">
                        {work.description}
                      </p>
                      <a
                        href={work.href}
                        class="block work-cta lg:inline-flex items-center gap-1 text-base font-medium font-mono hover:text-primary transition-colors duration-200 w-fit group"
                      >
                        <span class="work-cta-label">{work.ctaLabel}</span>
                        <span
                          class="work-cta-arrow transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                          aria-hidden="true"
                        >
                          ↗
                        </span>
                      </a>
                    </div>
                  </div>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</works-section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  class WorksSection extends HTMLElement {
    private cleanup: (() => void) | null = null;

    connectedCallback() {
      if (this.dataset.worksInitialized === "true") return;
      this.dataset.worksInitialized = "true";

      const tabs = Array.from(
        this.querySelectorAll<HTMLButtonElement>(".category-tab"),
      );
      const panels = Array.from(
        this.querySelectorAll<HTMLElement>(".works-panel"),
      );
      const statementWrap = this.querySelector<HTMLElement>(
        "[data-works-statements]",
      );
      const statements = statementWrap
        ? Array.from(statementWrap.querySelectorAll<HTMLElement>("p"))
        : [];
      const titleEl = this.querySelector<HTMLElement>("[data-works-title]");
      const categoryList = this.querySelector<HTMLElement>(
        "[data-works-tablist]",
      );

      if (!tabs.length || tabs.length !== panels.length) return;

      const mobileMq = window.matchMedia("(max-width: 1023px)");
      const reducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      );
      const isMobileLayout = () => mobileMq.matches;

      const cardsOf = (panel: HTMLElement) =>
        Array.from(panel.querySelectorAll<HTMLElement>(".work-card"));

      let currentIndex = panels.findIndex((panel) => !panel.hidden);
      if (currentIndex < 0) currentIndex = 0;
      let activeTimeline: gsap.core.Timeline | null = null;
      let entranceTl: gsap.core.Timeline | null = null;

      gsap.registerPlugin(ScrollTrigger);

      // ─── Entrance animation (scrubbed, reversible) ───
      const mm = gsap.matchMedia();
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        const tl = gsap.timeline({
          scrollTrigger: {
            trigger: this,
            start: "top 80%",
            end: "top 30%",
            scrub: 1,
          },
        });
        entranceTl = tl;

        if (titleEl) {
          tl.fromTo(
            titleEl,
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, ease: "power2.out", immediateRender: false },
          );
        }
        if (statementWrap) {
          tl.fromTo(
            statementWrap,
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, ease: "power2.out", immediateRender: false },
            "-=0.3",
          );
        }
        if (categoryList) {
          tl.fromTo(
            categoryList,
            { y: 20, opacity: 0 },
            { y: 0, opacity: 1, ease: "power2.out", immediateRender: false },
            "-=0.3",
          );
        }

        const cards = cardsOf(panels[currentIndex]);
        if (cards.length) {
          tl.fromTo(
            cards,
            { y: 40, opacity: 0 },
            {
              y: 0,
              opacity: 1,
              stagger: 0.1,
              ease: "power3.out",
              immediateRender: false,
            },
            "-=0.2",
          );
        }
      });

      const releaseEntrance = () => {
        if (!entranceTl) return;
        entranceTl.scrollTrigger?.kill();
        entranceTl.kill();
        entranceTl = null;
        const settled = [titleEl, statementWrap, categoryList].filter(
          (el): el is HTMLElement => Boolean(el),
        );
        gsap.set(settled, { clearProps: "opacity,transform" });
        panels.forEach((panel) =>
          gsap.set(cardsOf(panel), { clearProps: "opacity,transform" }),
        );
      };

      // ─── Category switching ───
      const setTabState = (index: number) => {
        tabs.forEach((tab, tabIndex) => {
          const active = tabIndex === index;
          tab.setAttribute("aria-selected", active ? "true" : "false");
          tab.tabIndex = active ? 0 : -1;

          if (active) {
            tab.classList.add("is-active", "bg-white", "text-black");
            tab.classList.remove("text-gray-300", "hover:text-white");
          } else {
            tab.classList.remove("is-active", "bg-white", "text-black");
            tab.classList.add("text-gray-300", "hover:text-white");
          }
        });
      };

      const activate = (index: number) => {
        if (index === currentIndex || !panels[index]) return;

        releaseEntrance();

        const previousIndex = currentIndex;
        currentIndex = index;

        setTabState(index);

        panels[previousIndex].hidden = true;
        panels[index].hidden = false;

        if (statements[previousIndex]) statements[previousIndex].hidden = true;
        if (statements[index]) statements[index].hidden = false;

        if (isMobileLayout()) {
          const grid =
            panels[index].querySelector<HTMLElement>("[data-works-grid]");
          if (grid) grid.scrollLeft = 0;
        }

        const cards = cardsOf(panels[index]);
        activeTimeline?.kill();
        activeTimeline = null;
        gsap.set(cards, { clearProps: "opacity,transform" });

        ScrollTrigger.refresh();

        if (reducedMotion.matches) return;

        activeTimeline = gsap.timeline();

        if (statements[index]) {
          activeTimeline.fromTo(
            statements[index],
            { opacity: 0, y: 6 },
            {
              opacity: 1,
              y: 0,
              duration: 0.25,
              ease: "power2.out",
              overwrite: "auto",
            },
            0,
          );
        }

        if (cards.length) {
          activeTimeline.fromTo(
            cards,
            { opacity: 0, y: 12 },
            {
              opacity: 1,
              y: 0,
              duration: 0.3,
              stagger: 0.04,
              ease: "power2.out",
              overwrite: "auto",
            },
            0,
          );
        }
      };

      // ─── Tab interaction (WAI-ARIA horizontal tablist) ───
      const NAV_KEYS = ["ArrowLeft", "ArrowRight", "Home", "End"];

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index));

        tab.addEventListener("keydown", (event) => {
          if (!NAV_KEYS.includes(event.key)) return;
          event.preventDefault();

          let next = currentIndex;
          if (event.key === "Home") next = 0;
          else if (event.key === "End") next = tabs.length - 1;
          else if (event.key === "ArrowRight")
            next = Math.min(currentIndex + 1, tabs.length - 1);
          else if (event.key === "ArrowLeft")
            next = Math.max(currentIndex - 1, 0);

          activate(next);
          tabs[next]?.focus();
        });
      });

      // ─── Reduced motion mid-session ───
      const onReducedMotionChange = () => {
        if (!reducedMotion.matches) return;
        activeTimeline?.kill();
        activeTimeline = null;
        releaseEntrance();
        gsap.set(statements, { clearProps: "opacity,transform" });
      };
      reducedMotion.addEventListener("change", onReducedMotionChange);

      // ─── Preload hidden panel images when the section approaches viewport ───
      let warmed = false;
      const warmHiddenImages = () => {
        if (warmed) return;
        warmed = true;
        this.querySelectorAll<HTMLImageElement>(
          ".works-panel[hidden] img",
        ).forEach((img) => {
          img.loading = "eager";
        });
      };

      let warmObserver: IntersectionObserver | null = null;
      if ("IntersectionObserver" in window) {
        warmObserver = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            warmHiddenImages();
            warmObserver?.disconnect();
            warmObserver = null;
          },
          { rootMargin: "400px" },
        );
        warmObserver.observe(this);
      } else {
        warmHiddenImages();
      }

      this.cleanup = () => {
        reducedMotion.removeEventListener("change", onReducedMotionChange);
        warmObserver?.disconnect();
        warmObserver = null;
        activeTimeline?.kill();
        activeTimeline = null;
        mm.revert();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = null;
      delete this.dataset.worksInitialized;
    }
  }

  if (!customElements.get("works-section")) {
    customElements.define("works-section", WorksSection);
  }
</script>
