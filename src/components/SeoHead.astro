---
import type { Lang } from "../i18n/index";
import { getAlternatePaths, useTranslations } from "../i18n/index";

export interface Props {
  lang: Lang;
  page: "home" | "about-me" | "uxui" | "frontend" | "visualArtist" | "projects" | "contact" | "terms" | "privacy" | "error";
  pathname: string;
  title?: string;
  description?: string;
}

const { lang, page, pathname, title: customTitle, description: customDescription } = Astro.props;
const { t, tArray } = useTranslations(lang);

const seoKey = page === "home" ? "home" : page === "about-me" ? "aboutMe" : page;
const title = customTitle || t(`seo.${seoKey}.title`);
const description = customDescription || t(`seo.${seoKey}.description`);
const siteUrl = "https://keishmerstudio.com";
const normalizePath = (path: string) => {
  const cleanPath = path.replace(/\/{2,}/g, "/");
  if (cleanPath === "/") return "/";
  return cleanPath.endsWith("/") ? cleanPath : `${cleanPath}/`;
};
const alternatePaths = getAlternatePaths(pathname);
const canonical = `${siteUrl}${normalizePath(pathname)}`;
const alternateEn = `${siteUrl}${normalizePath(alternatePaths.en)}`;
const alternateEs = `${siteUrl}${normalizePath(alternatePaths.es)}`;
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={t("site.author")} />
<meta name="theme-color" content="#121314" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="robots" content={page === "error" ? "noindex" : "index, follow"} />
<link rel="canonical" href={canonical} />

<!-- Alternate language links -->
<link rel="alternate" hreflang="en" href={alternateEn} />
<link rel="alternate" hreflang="es" href={alternateEs} />
<link rel="alternate" hreflang="x-default" href={alternateEn} />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content="https://keishmerstudio.com/og-image.png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={description} />
<meta property="og:site_name" content={t("site.title")} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "en" ? "en_US" : "es_ES"} />

<!-- JSON-LD Person -->
{(page === "home" || page === "about-me") && (
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://keishmerstudio.com/#person",
  "name": t("jsonld.personName"),
  "jobTitle": t("jsonld.jobTitle"),
  "url": "https://keishmerstudio.com",
  "image": "https://keishmerstudio.com/og-image.png",
  "sameAs": [
    "https://www.linkedin.com/in/keishmer-p%C3%A9rez-torres/",
    "https://github.com/Keishmer00",
    "https://www.instagram.com/keishmer00/"
  ],
  "email": "kshmr044@gmail.com",
  "knowsAbout": tArray("jsonld.knowsAbout"),
  "homeLocation": {
    "@type": "Place",
    "name": "Cúcuta, Norte de Santander, Colombia"
  },
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Cúcuta",
    "addressRegion": "Norte de Santander",
    "addressCountry": "CO"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "Move On Tech Service",
    "url": "https://moveonts.com/"
  },
  "alumniOf": [
    { "@type": "CollegeOrUniversity", "name": "Universidad Internacional de La Rioja" },
    { "@type": "CollegeOrUniversity", "name": "Universidad de Pamplona" }
  ]
})} />
)}

{page === "home" && (
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": "https://keishmerstudio.com/#service",
  "name": "Keishmer Studio",
  "url": siteUrl,
  "email": "kshmr044@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Cúcuta",
    "addressRegion": "Norte de Santander",
    "addressCountry": "CO"
  },
  "areaServed": ["Colombia", "United States", "Latin America", "Worldwide"],
  "availableLanguage": ["English", "Spanish"],
  "serviceType": ["UX/UI Design", "Frontend Development", "Branding", "Design Systems", "Visual Art"],
  "provider": { "@id": "https://keishmerstudio.com/#person" }
})} />
)}

<!-- JSON-LD WebSite -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": t("site.title"),
  "url": "https://keishmerstudio.com",
  "description": t("site.description"),
  "image": "https://keishmerstudio.com/og-image.png",
  "inLanguage": lang === "en" ? "en-US" : "es-ES"
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": title,
  "description": description,
  "url": canonical,
  "inLanguage": lang === "en" ? "en-US" : "es-ES",
  "isPartOf": {
    "@type": "WebSite",
    "url": "https://keishmerstudio.com"
  }
})} />
