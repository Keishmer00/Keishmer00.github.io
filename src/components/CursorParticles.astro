---
// Cursor Particle System - Trail on movement, idle orbit ring on desktop only
---

<canvas id="cursor-particles" class="fixed inset-0 pointer-events-none z-[100] hidden lg:block"></canvas>

<style>
  @media (min-width: 1024px) and (pointer: fine) {
    :global(body.cursor-custom),
    :global(body.cursor-custom *) {
      cursor: none !important;
    }
  }
</style>

<script>
  // Desktop-only: mouse pointer + large screen
  const isDesktop = window.matchMedia('(min-width: 1024px) and (pointer: fine)').matches;
  if (!isDesktop) {
    // Do not initialize on mobile/tablet to save battery/CPU
    const canvas = document.getElementById('cursor-particles');
    if (canvas) canvas.remove();
    throw new Error('CursorParticles skipped: not desktop');
  }

  const canvasEl = document.getElementById('cursor-particles');
  if (!canvasEl) throw new Error('Canvas element not found');
  const canvas = canvasEl as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');
  if (!ctx) throw new Error('Could not get 2D context');

  // Hide native cursor on desktop once the custom cursor is active
  document.body.classList.add('cursor-custom');

  const primaryColor = getComputedStyle(document.documentElement).getPropertyValue('--color-primary').trim() || '#FF6B6B';
  const BASE_CURSOR_RADIUS = 10;
  const HOVER_CURSOR_RADIUS = 12;
  const RING_EXTRA_RADIUS = 8;
  const RING_STROKE_WIDTH = 1.5;

  let currentCursorRadius = BASE_CURSOR_RADIUS;
  let targetCursorRadius = BASE_CURSOR_RADIUS;
  let currentRingRadius = 0;
  let targetRingRadius = 0;
  let currentRingAlpha = 0;
  let targetRingAlpha = 0;
  let isOverPrimaryBackground = false;

  let width = window.innerWidth;
  let height = window.innerHeight;
  canvas.width = width;
  canvas.height = height;

  let targetX = width / 2;
  let targetY = height / 2;
  let lastMoveTime = Date.now();

  const particles: Particle[] = [];
  const particleColor = 'rgba(198, 210, 212, '; // #c6d2d4 - project white

  // Configuration
  const IDLE_THRESHOLD = 80; // ms without movement to enter idle mode
  const IDLE_COUNT = 20; // particles in the idle ring
  const IDLE_RADIUS = 25; // base orbit radius in px
  const IDLE_ORBIT_SPEED = 0.002; // radians per frame (slow)
  const MAX_TRAIL_PARTICLES = 60;

  interface Particle {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    life: number;
    maxLife: number;
    alpha: number;
    mode: 'trail' | 'idle';
    angle: number;
    radius: number;
    speed: number;
  }

  class Particle {
    constructor(x: number, y: number, mode: 'trail' | 'idle' = 'trail', startAngle?: number) {
      this.x = x;
      this.y = y;
      this.mode = mode;
      this.size = Math.random() * 2 + 1;
      this.life = 0;
      this.angle = 0;
      this.radius = 0;
      this.speed = 0;

      if (mode === 'trail') {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 2 + 0.5;
        this.vx = Math.cos(angle) * speed;
        this.vy = Math.sin(angle) * speed;
        this.maxLife = Math.random() * 40 + 30;
        this.alpha = 1;
      } else {
        // Idle orbit
        this.angle = startAngle ?? Math.random() * Math.PI * 2;
        this.radius = IDLE_RADIUS + (Math.random() - 0.5) * 20;
        this.speed = IDLE_ORBIT_SPEED * (Math.random() > 0.5 ? 1 : -1);
        this.vx = 0;
        this.vy = 0;
        this.maxLife = Infinity;
        this.alpha = 0.8;
      }
    }

    update(targetX: number, targetY: number) {
      if (this.mode === 'idle') {
        // Orbit slowly around cursor
        this.angle += this.speed;
        const orbitX = targetX + Math.cos(this.angle) * this.radius;
        const orbitY = targetY + Math.sin(this.angle) * this.radius;

        // Smooth approach to orbit position
        this.x += (orbitX - this.x) * 0.08;
        this.y += (orbitY - this.y) * 0.08;

        this.life++;
        // Gentle alpha pulse
        this.alpha = 0.5 + Math.sin(this.life * 0.04) * 0.25;
      } else {
        // Trail physics
        this.x += this.vx;
        this.y += this.vy;
        this.vx *= 0.98;
        this.vy *= 0.98;
        this.life++;
        this.alpha = Math.max(0, 1 - this.life / this.maxLife);
      }
    }

    draw() {
      if (!ctx) return;
      ctx.strokeStyle = particleColor + this.alpha + ')';
      ctx.lineWidth = 1;
      ctx.strokeRect(this.x - this.size / 2, this.y - this.size / 2, this.size, this.size);
    }

    toTrail() {
      this.mode = 'trail';
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 3 + 0.8;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed;
      this.maxLife = Math.random() * 40 + 30;
      this.life = 0;
      this.alpha = 1;
    }

    toIdle(startAngle: number) {
      this.mode = 'idle';
      this.angle = startAngle;
      this.radius = IDLE_RADIUS + (Math.random() - 0.5) * 20;
      this.speed = IDLE_ORBIT_SPEED * (Math.random() > 0.5 ? 1 : -1);
      this.vx = 0;
      this.vy = 0;
      this.maxLife = Infinity;
      this.alpha = 0.8;
    }
  }

  function createTrailParticle(x: number, y: number) {
    if (particles.filter(p => p.mode === 'trail').length < MAX_TRAIL_PARTICLES) {
      particles.push(new Particle(x, y, 'trail'));
    }
  }

  function connectParticles() {
    if (!ctx) return;
    for (let i = 0; i < particles.length; i++) {
      for (let j = i + 1; j < particles.length; j++) {
        const dx = particles[i].x - particles[j].x;
        const dy = particles[i].y - particles[j].y;
        const distance = Math.sqrt(dx * dx + dy * dy);

        if (distance < 80) {
          const alpha = (1 - distance / 80) * Math.min(particles[i].alpha, particles[j].alpha) * 0.3;
          ctx.beginPath();
          ctx.moveTo(particles[i].x, particles[i].y);
          ctx.lineTo(particles[j].x, particles[j].y);
          ctx.strokeStyle = particleColor + alpha + ')';
          ctx.lineWidth = 0.5;
          ctx.stroke();
        }
      }
    }
  }

  function animate() {
    ctx!.clearRect(0, 0, width, height);

    // Smooth cursor radius transitions
    currentCursorRadius += (targetCursorRadius - currentCursorRadius) * 0.15;
    currentRingRadius += (targetRingRadius - currentRingRadius) * 0.12;
    currentRingAlpha += (targetRingAlpha - currentRingAlpha) * 0.12;

    const timeSinceLastMove = Date.now() - lastMoveTime;
    const isIdle = timeSinceLastMove > IDLE_THRESHOLD;

    if (isIdle) {
      // Maintain idle ring
      const idleParticles = particles.filter(p => p.mode === 'idle');
      if (idleParticles.length < IDLE_COUNT && Math.random() < 0.4) {
        const angle = (idleParticles.length / IDLE_COUNT) * Math.PI * 2;
        particles.push(new Particle(targetX, targetY, 'idle', angle));
      }

      // Convert surviving trail particles into idle orbiters
      const trailParticles = particles.filter(p => p.mode === 'trail');
      for (let i = 0; i < Math.min(2, trailParticles.length); i++) {
        const idx = particles.indexOf(trailParticles[i]);
        if (idx !== -1) {
          const angle = (idleParticles.length / IDLE_COUNT) * Math.PI * 2;
          particles[idx].toIdle(angle);
        }
      }
    } else {
      // Cursor is moving: spawn trail
      if (Math.random() < 0.7) {
        createTrailParticle(targetX, targetY);
      }

      // Burst idle ring particles into trail
      const idleParticles = particles.filter(p => p.mode === 'idle');
      for (let i = 0; i < Math.min(3, idleParticles.length); i++) {
        const idx = particles.indexOf(idleParticles[i]);
        if (idx !== -1) {
          particles[idx].toTrail();
        }
      }
    }

    // Update and draw particles
    for (let i = particles.length - 1; i >= 0; i--) {
      particles[i].update(targetX, targetY);
      particles[i].draw();

      // Remove dead trail particles
      if (particles[i].mode === 'trail' && particles[i].life >= particles[i].maxLife) {
        particles.splice(i, 1);
      }
    }

    // Cap idle particles
    const idleParticles = particles.filter(p => p.mode === 'idle');
    if (idleParticles.length > IDLE_COUNT) {
      // Remove oldest idle particles
      const toRemove = idleParticles.length - IDLE_COUNT;
      for (let i = 0; i < toRemove; i++) {
        const idx = particles.indexOf(idleParticles[i]);
        if (idx !== -1) particles.splice(idx, 1);
      }
    }

    connectParticles();

    // Switch cursor color to black when over primary background for contrast
    const cursorColor = isOverPrimaryBackground ? '#121314' : primaryColor;

    // Draw hover ring (border only)
    if (currentRingAlpha > 0.01) {
      ctx!.beginPath();
      ctx!.arc(targetX, targetY, currentRingRadius, 0, Math.PI * 2);
      ctx!.strokeStyle = cursorColor;
      ctx!.lineWidth = RING_STROKE_WIDTH;
      ctx!.globalAlpha = currentRingAlpha;
      ctx!.stroke();
      ctx!.globalAlpha = 1;
    }

    // Draw cursor dot at exact mouse position
    ctx!.beginPath();
    ctx!.arc(targetX, targetY, currentCursorRadius, 0, Math.PI * 2);
    ctx!.fillStyle = cursorColor;
    ctx!.fill();

    requestAnimationFrame(animate);
  }

  function isPointerElement(el: EventTarget | null): boolean {
    if (!el || !(el instanceof Element)) return false;
    let current: Element | null = el;
    while (current && current !== document.body) {
      const style = getComputedStyle(current);
      if (style.cursor === 'pointer') return true;

      const tag = current.tagName.toLowerCase();
      if (
        tag === 'a' ||
        tag === 'button' ||
        tag === 'input' ||
        tag === 'textarea' ||
        tag === 'select' ||
        tag === 'label' ||
        current.hasAttribute('onclick') ||
        current.getAttribute('role') === 'button' ||
        current.getAttribute('role') === 'link'
      ) {
        return true;
      }

      current = current.parentElement;
    }
    return false;
  }

  function isOverPrimary(el: EventTarget | null): boolean {
    if (!el || !(el instanceof Element)) return false;
    let current: Element | null = el;
    while (current && current !== document.body) {
      if (current.classList.contains('bg-primary')) return true;
      const style = getComputedStyle(current);
      const bg = style.backgroundColor;
      if (bg && bg !== 'rgba(0, 0, 0, 0)' && bg !== 'transparent') {
        // Convert rgb/rgba to hex for comparison
        const rgb = bg.match(/\d+/g);
        if (rgb && rgb.length >= 3) {
          const hex = `#${((1 << 24) + (parseInt(rgb[0]) << 16) + (parseInt(rgb[1]) << 8) + parseInt(rgb[2])).toString(16).slice(1).toUpperCase()}`;
          if (hex === primaryColor.toUpperCase()) return true;
        }
      }
      current = current.parentElement;
    }
    return false;
  }

  // Mouse move handler (desktop only)
  document.addEventListener('mousemove', (e: MouseEvent) => {
    targetX = e.clientX;
    targetY = e.clientY;
    lastMoveTime = Date.now();

    const hovered = document.elementFromPoint(e.clientX, e.clientY);
    isOverPrimaryBackground = isOverPrimary(hovered);

    if (isPointerElement(hovered)) {
      targetCursorRadius = HOVER_CURSOR_RADIUS;
      targetRingRadius = HOVER_CURSOR_RADIUS + RING_EXTRA_RADIUS;
      targetRingAlpha = 1;
    } else {
      targetCursorRadius = BASE_CURSOR_RADIUS;
      targetRingRadius = 0;
      targetRingAlpha = 0;
    }
  });

  // Resize handler
  window.addEventListener('resize', () => {
    width = window.innerWidth;
    height = window.innerHeight;
    canvas.width = width;
    canvas.height = height;
  });

  // Start animation
  animate();
</script>
