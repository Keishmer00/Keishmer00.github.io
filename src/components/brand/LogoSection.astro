---
import type { Lang } from "../../i18n/index";
import { useTranslations } from "../../i18n/index";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t, tArray } = useTranslations(lang);
---

<section id="logo" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.logo.eyebrow")}
    title={t("brand.sections.logo.title")}
    intro={t("brand.sections.logo.intro")}
  />

  <!-- Primary wordmark (Unbounded — the footer logo) -->
  <figure class="mt-12 flex flex-col gap-3">
    <div class="flex h-44 items-center justify-center border border-border-subtle bg-surface-page px-6">
      <span class="font-unbounded text-3xl font-bold uppercase leading-tight text-text-primary md:text-5xl">
        {t("footer.logo")}
      </span>
    </div>
    <figcaption class="font-mono text-xs uppercase tracking-wider text-text-muted">
      {t("brand.sections.logo.wordmarkLabel")}
    </figcaption>
  </figure>

  <div class="mt-4 grid gap-4 md:grid-cols-2">
    <!-- Secondary wordmark (Mono — the nav logo) -->
    <figure class="flex flex-col gap-3">
      <div class="flex h-44 items-center justify-center border border-border-subtle bg-surface-page px-6">
        <span class="font-mono text-2xl uppercase tracking-widest text-text-primary md:text-3xl">
          {t("nav.logo")}
        </span>
      </div>
      <figcaption class="font-mono text-xs uppercase tracking-wider text-text-muted">
        {t("brand.sections.logo.wordmarkSecondaryLabel")}
      </figcaption>
    </figure>

    <!-- K monogram (the favicon: the letter K in Unbounded) -->
    <figure class="flex flex-col gap-3">
      <div class="flex h-44 items-center justify-center border border-border-subtle bg-surface-page px-6">
        <span class="font-unbounded text-7xl font-extrabold leading-none text-text-primary" aria-hidden="true">K</span>
      </div>
      <figcaption class="font-mono text-xs uppercase tracking-wider text-text-muted">
        {t("brand.sections.logo.monogramLabel")}
      </figcaption>
    </figure>
  </div>

  <!-- Rules -->
  <div class="mt-10 grid gap-4 md:grid-cols-3">
    <div class="border border-border-subtle p-6">
      <div class="flex h-24 items-center justify-center border border-dashed border-primary/60 p-6">
        <span class="font-mono text-lg uppercase tracking-widest text-text-primary">
          {t("nav.logo")}
        </span>
      </div>
      <h4 class="mt-4 font-mono text-sm uppercase tracking-widest text-text-primary">
        {t("brand.sections.logo.clearSpaceTitle")}
      </h4>
      <p class="mt-2 font-albert text-sm leading-relaxed text-text-muted">
        {t("brand.sections.logo.clearSpaceBody")}
      </p>
    </div>

    <div class="border border-border-subtle p-6">
      <div class="flex h-24 flex-col items-center justify-center gap-4">
        <span class="font-unbounded text-[11px] font-bold uppercase tracking-widest text-text-primary">
          {t("footer.logo")}
        </span>
        <span class="font-unbounded text-lg font-extrabold leading-none text-text-primary" aria-hidden="true">K</span>
      </div>
      <h4 class="mt-4 font-mono text-sm uppercase tracking-widest text-text-primary">
        {t("brand.sections.logo.minSizeTitle")}
      </h4>
      <p class="mt-2 font-albert text-sm leading-relaxed text-text-muted">
        {t("brand.sections.logo.minSizeBody")}
      </p>
    </div>

    <div class="border border-border-subtle p-6">
      <h4 class="flex h-24 items-center font-mono text-sm uppercase tracking-widest text-text-accent">
        {t("brand.sections.logo.dontsTitle")}
      </h4>
      <ul class="mt-2 flex flex-col gap-2">
        {
          tArray("brand.sections.logo.donts").map((item) => (
            <li class="flex items-start gap-2 font-albert text-sm text-text-muted">
              <span class="text-text-accent" aria-hidden="true">×</span>
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
