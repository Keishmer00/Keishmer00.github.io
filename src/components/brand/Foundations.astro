---
import type { Lang } from "../../i18n/index";
import { useTranslations } from "../../i18n/index";
import {
  spacingScale,
  radiusScale,
  strokeScale,
  motionDurations,
  motionEasings,
  breakpoints,
} from "../../lib/tokens";
import SectionHeading from "./SectionHeading.astro";
import ServiceBanner from "../ServiceBanner.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const maxSpacing = Math.max(...spacingScale.map((s) => s.px));

// Sample gradient recipes actually used across the site.
const gradients = [
  "bg-linear-to-r from-surface-page via-surface-page/50 to-surface-page",
  "bg-linear-to-t from-surface-page/85 via-surface-page/40 to-surface-page/20",
  "bg-radial from-surface-page via-surface-page/50 to-surface-page",
];
---

<!-- Spacing -->
<section id="spacing" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.spacing.eyebrow")}
    title={t("brand.sections.spacing.title")}
    intro={t("brand.sections.spacing.intro")}
  />
  <div class="mt-12">
    <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
      {t("brand.sections.spacing.scaleTitle")}
    </h3>
    <ul class="mt-6 flex flex-col gap-3">
      {
        spacingScale.map((step) => (
          <li class="flex items-center gap-4">
            <span class="w-14 shrink-0 font-mono text-xs text-text-muted">
              {step.token}
            </span>
            <span
              class="h-4 bg-primary"
              style={`width:${(step.px / maxSpacing) * 100}%`}
            />
            <span class="font-mono text-[11px] text-text-muted">{step.px}px</span>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="mt-10 border border-border-subtle bg-surface-inverse/5 p-6">
    <h4 class="font-mono text-sm uppercase tracking-widest text-text-primary">
      {t("brand.sections.spacing.rhythmTitle")}
    </h4>
    <p class="mt-3 font-albert text-sm leading-relaxed text-text-secondary md:text-base">
      {t("brand.sections.spacing.rhythmBody")}
    </p>
  </div>
</section>

<!-- Radius & stroke -->
<section id="radius" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.radius.eyebrow")}
    title={t("brand.sections.radius.title")}
    intro={t("brand.sections.radius.intro")}
  />
  <div class="mt-12 grid gap-10 md:grid-cols-2">
    <div>
      <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
        {t("brand.sections.radius.radiusTitle")}
      </h3>
      <ul class="mt-6 flex flex-wrap items-end gap-4">
        {
          radiusScale.map((r) => (
            <li class="flex flex-col items-start gap-2">
              <span
                class={`block h-20 w-20 border border-border-default bg-surface-muted ${r.cls}`}
              />
              <span class="font-mono text-[11px] text-text-muted">
                {r.cls} · {r.value}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
        {t("brand.sections.radius.strokeTitle")}
      </h3>
      <ul class="mt-6 flex flex-wrap items-end gap-4">
        {
          strokeScale.map((s) => (
            <li class="flex flex-col items-start gap-2">
              <span
                class="block h-20 w-20 border-border-default bg-transparent"
                style={`border-width:${s.px}px`}
              />
              <span class="font-mono text-[11px] text-text-muted">{s.px}px</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="mt-8 font-mono text-xs uppercase tracking-wider text-text-muted">
    {t("brand.sections.radius.note")}
  </p>
</section>

<!-- Elevation -->
<section id="elevation" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.elevation.eyebrow")}
    title={t("brand.sections.elevation.title")}
    intro={t("brand.sections.elevation.intro")}
  />
  <div class="mt-12 grid gap-4 sm:grid-cols-3">
    <div class="border border-border-subtle bg-surface-muted p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-text-secondary">
        {t("brand.sections.elevation.notes.flat")}
      </p>
    </div>
    <div
      class="cursor-pointer border border-border-strong bg-surface-page p-6 transition-shadow duration-300 hover:border-primary hover:shadow-lg hover:shadow-primary/50"
    >
      <p class="font-mono text-xs uppercase tracking-widest text-text-secondary">
        {t("brand.sections.elevation.notes.glow")}
      </p>
    </div>
    <div class="border border-border-subtle bg-surface-muted p-6">
      <p class="font-mono text-xs uppercase tracking-widest text-text-secondary">
        {t("brand.sections.elevation.notes.drop")}
      </p>
    </div>
  </div>
</section>

<!-- Motion -->
<section id="motion" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.motion.eyebrow")}
    title={t("brand.sections.motion.title")}
    intro={t("brand.sections.motion.intro")}
  />
  <div class="mt-12 grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
        {t("brand.sections.motion.durationTitle")}
      </h3>
      <ul class="mt-6 flex flex-col gap-5">
        {
          motionDurations.map((d) => (
            <li class="group">
              <div class="flex items-baseline justify-between font-mono text-xs text-text-muted">
                <span>{d.cls}</span>
                <span class="text-text-muted">{d.ms}ms</span>
              </div>
              <div class="mt-2 h-1.5 w-full bg-surface-muted">
                <div
                  class={`h-full w-0 bg-primary transition-all ${d.cls} group-hover:w-full`}
                />
              </div>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-mono text-[11px] uppercase tracking-wider text-text-muted">
        {t("brand.sections.motion.reducedNote")}
      </p>
    </div>
    <div>
      <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
        {t("brand.sections.motion.easingTitle")}
      </h3>
      <ul class="mt-6 flex flex-col border-t border-border-subtle">
        {
          motionEasings.map((e) => (
            <li class="border-b border-border-subtle py-3">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <span class="font-mono text-xs text-text-primary">power</span>
                <span class="font-mono text-[11px] text-text-muted">{e.css}</span>
              </div>
              <p class="mt-1 font-albert text-xs text-text-muted">
                {t(`brand.sections.motion.easingNotes.${e.id}`)}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<!-- Layout -->
<section id="layout" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.layout.eyebrow")}
    title={t("brand.sections.layout.title")}
    intro={t("brand.sections.layout.intro")}
  />
  <div class="mt-12 overflow-x-auto">
    <table class="w-full border-collapse text-left">
      <thead>
        <tr class="border-b border-border-subtle font-mono text-xs uppercase tracking-widest text-text-muted">
          <th class="py-3 pr-6 font-medium">{t("brand.sections.layout.breakpointsTitle")}</th>
          <th class="py-3 font-medium">min-width</th>
        </tr>
      </thead>
      <tbody class="font-mono text-sm">
        {
          breakpoints.map((bp) => (
            <tr class="border-b border-border-subtle">
              <td class="py-3 pr-6 text-text-accent">{bp.cls}</td>
              <td class="py-3 text-text-secondary">{bp.minWidth}px</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="mt-6 font-albert text-sm leading-relaxed text-text-secondary md:text-base">
    {t("brand.sections.layout.containerNote")}
  </p>
</section>

<!-- Iconography -->
<section id="iconography" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.iconography.eyebrow")}
    title={t("brand.sections.iconography.title")}
    intro={t("brand.sections.iconography.intro")}
  />
  <div class="mt-12 flex flex-wrap items-center gap-8">
    <div class="flex items-center gap-3 text-text-primary">
      <svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20" fill="currentColor"><path d="m264-213 73-36q-9-30-16.5-60.5T308-371l-44 34v124Zm144-51h144q16-47 26-94.5t10-97.5q0-88-22.5-173T480-776q-63 63-85.5 147.5T372-456q0 50 10.5 97.5T408-264Zm21-213q-21-21-21-51t21-51q21-21 51-21t51 21q21 21 21 51t-21 51q-21 21-51 21t-51-21Zm267 264v-124l-44-34q-5 31-12.5 61.5T623-249l73 36ZM480-864q95 57 137.5 166T660-480v24l80 62q13 11 20.5 25.5T768-337v241l-192-96H384L192-96v-241q0-17 7-32t21-25l80-62v-24q0-109 43-218t137-166Z"/></svg>
      <span class="font-mono text-xs text-text-muted">20px</span>
    </div>
    <div class="flex items-center gap-3 text-text-accent">
      <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24" fill="currentColor"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg>
      <span class="font-mono text-xs text-text-muted">24px</span>
    </div>
    <div class="flex items-center gap-3 text-text-muted">
      <svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24" fill="currentColor"><path d="M480-480q-66 0-113-47t-47-113q0-66 47-113t113-47q66 0 113 47t47 113q0 66-47 113t-113 47ZM160-160v-112q0-34 17.5-62.5T224-378q62-31 126-46.5T480-440q66 0 130 15.5T736-378q29 15 46.5 43.5T800-272v112H160Z"/></svg>
      <span class="font-mono text-xs text-text-muted">currentColor</span>
    </div>
  </div>
  <p class="mt-6 font-albert text-sm leading-relaxed text-text-secondary md:text-base">
    {t("brand.sections.iconography.note")}
  </p>
</section>

<!-- Effects -->
<section id="effects" class="scroll-mt-28">
  <SectionHeading
    eyebrow={t("brand.sections.effects.eyebrow")}
    title={t("brand.sections.effects.title")}
    intro={t("brand.sections.effects.intro")}
  />
  <div class="mt-12 grid gap-10 lg:grid-cols-2">
    <div>
      <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
        {t("brand.sections.effects.gradientsTitle")}
      </h3>
      <ul class="mt-6 flex flex-col gap-3">
        {
          gradients.map((g) => (
            <li class="relative flex h-20 items-end overflow-hidden border border-border-subtle p-3">
              <span class={`absolute inset-0 ${g}`} aria-hidden="true" />
              <span class="relative font-mono text-[11px] text-text-muted">{g}</span>
            </li>
          ))
        }
      </ul>
      <p class="mt-4 font-albert text-sm leading-relaxed text-text-secondary">
        {t("brand.sections.effects.gradientsBody")}
      </p>
    </div>
    <div class="flex flex-col gap-6">
      <div>
        <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
          {t("brand.sections.effects.canvasTitle")}
        </h3>
        <p class="mt-4 font-albert text-sm leading-relaxed text-text-secondary">
          {t("brand.sections.effects.canvasBody")}
        </p>
      </div>
      <div>
        <h3 class="font-unbounded text-lg font-bold uppercase text-text-primary">
          {t("brand.sections.effects.marqueeTitle")}
        </h3>
        <p class="mt-4 font-albert text-sm leading-relaxed text-text-secondary">
          {t("brand.sections.effects.marqueeBody")}
        </p>
      </div>
    </div>
  </div>
  <div class="mt-8 overflow-hidden border border-border-subtle">
    <ServiceBanner lang={lang} />
  </div>
</section>
