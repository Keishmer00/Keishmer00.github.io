---
interface Props {
  eyebrow: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<div class="border-b border-white/10 pb-6">
  <p class="font-mono text-xs uppercase tracking-widest text-primary md:text-sm">
    {eyebrow}
  </p>
  <h2
    class="mt-3 font-unbounded text-2xl font-bold uppercase leading-tight text-white md:text-4xl"
  >
    {title}
  </h2>
  {
    intro && (
      <p class="mt-4 max-w-3xl font-albert text-base leading-relaxed text-gray-200 md:text-lg">
        {intro}
      </p>
    )
  }
</div>
