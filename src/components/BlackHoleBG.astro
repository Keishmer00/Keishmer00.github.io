---
export interface Props {
  speed?: number;
  strokeColor?: string;
  lineWidth?: number;
  lines?: number;
  discs?: number;
  particles?: boolean;
  particleColor?: string;
  particleCount?: number;
  glow?: boolean;
  glowColor?: string;
}

const {
  speed = 17,
  strokeColor = "#292929",
  lineWidth = 1,
  lines = 77,
  discs = 77,
  particles = true,
  particleColor = "#e99b9b",
  particleCount = 111,
  glow = true,
  glowColor = "#fff7f7",
} = Astro.props;
---

<div class="absolute inset-0 overflow-hidden bg-black" data-anim="blackhole">
  <div
    class="absolute top-1/2 left-1/2 w-[140%] h-[140%] -translate-x-1/2 -translate-y-1/2 pointer-events-none"
  ></div>

  <canvas
    id="blackhole-canvas"
    class="absolute inset-0 w-full h-full block"
    data-speed={speed}
    data-stroke-color={strokeColor}
    data-line-width={lineWidth}
    data-lines={lines}
    data-discs={discs}
    data-particles={particles}
    data-particle-color={particleColor}
    data-particle-count={particleCount}
    data-glow={glow}
    data-glow-color={glowColor}
  ></canvas>

  {glow && (
    <div
      class="absolute z-5 top-1/2 left-1/2 w-full h-full -translate-x-1/2 -translate-y-1/2 pointer-events-none"
      style={`background: radial-gradient(ellipse at 50% 75%, ${glowColor} 20%, transparent 75%); mix-blend-mode: overlay`}
    ></div>
  )}

  <div
    class="absolute z-7 top-0 left-0 w-full h-full pointer-events-none"
    style="background: repeating-linear-gradient(transparent, transparent 1px, #726666 1px, #121314 2px); mix-blend-mode: overlay"
  ></div>
</div>

<script>
(function () {
  interface Disc {
    p: number;
    x: number;
    y: number;
    w: number;
    h: number;
  }

  interface Point {
    x: number;
    y: number;
  }

  interface Clip {
    disc?: Disc;
    i?: number;
    path?: Path2D;
  }

  interface Particle {
    x: number;
    sx: number;
    dx: number;
    y: number;
    vy: number;
    p: number;
    r: number;
    c: string;
  }

  interface ParticleArea {
    sx: number;
    sw: number;
    ex: number;
    ew: number;
    h: number;
  }

  interface State {
    discs: Disc[];
    lines: Point[][];
    particles: Particle[];
    clip: Clip;
    startDisc: Disc;
    endDisc: Disc;
    rect: { width: number; height: number };
    render: { width: number; height: number; dpi: number };
    particleArea: ParticleArea;
    linesCanvas: HTMLCanvasElement | null;
  }

  var canvas = document.getElementById("blackhole-canvas") as HTMLCanvasElement;
  if (!canvas) return;
  var ctx: CanvasRenderingContext2D | null = canvas.getContext("2d");
  if (!ctx) return;

  var speed: number = parseFloat(canvas.dataset.speed || "") || 17;
  var strokeColor: string = canvas.dataset.strokeColor || "#C2C2C2";
  var lineWidth: number = parseFloat(canvas.dataset.lineWidth || "") || 1;
  var linesCount: number = parseInt(canvas.dataset.lines || "") || 83;
  var discsCount: number = parseInt(canvas.dataset.discs || "") || 93;
  var particlesEnabled: boolean = canvas.dataset.particles !== "false";
  var particleColor: string = canvas.dataset.particleColor || "#FF6B6B";
  var particleCount: number = parseInt(canvas.dataset.particleCount || "") || 161;
  var glowColor: string = canvas.dataset.glowColor || "#F5DDDD";

  function toRGB(color: string | number[]): number[] {
    if (typeof color === "string") {
      if (color.startsWith("#")) {
        var hex: string = color.slice(1);
        if (hex.length === 3)
          hex = hex
            .split("")
            .map(function (c: string) {
              return c + c;
            })
            .join("");
        var n: number = parseInt(hex.slice(0, 6), 16);
        return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
      }
      var m: RegExpMatchArray | null = color.match(/rgba?\(([^)]+)\)/);
      if (m) {
        var p: number[] = m[1].split(",").map(function (s: string) {
          return parseFloat(s);
        });
        return [p[0] || 0, p[1] || 0, p[2] || 0];
      }
    }
    return [255, 255, 255];
  }

  var particleRGB: number[] = toRGB(particleColor);
  var discInc: number = (speed / 100) * 0.002;
  var vyScale: number = speed / 50;

  var state: State = {
    discs: [],
    lines: [],
    particles: [],
    clip: {},
    startDisc: { p: 0, x: 0, y: 0, w: 0, h: 0 },
    endDisc: { p: 0, x: 0, y: 0, w: 0, h: 0 },
    rect: { width: 0, height: 0 },
    render: { width: 0, height: 0, dpi: 1 },
    particleArea: { sx: 0, sw: 0, ex: 0, ew: 0, h: 0 },
    linesCanvas: null,
  };

  function linear(p: number): number {
    return p;
  }
  function easeInExpo(p: number): number {
    return p === 0 ? 0 : Math.pow(2, 10 * (p - 1));
  }

  function tweenValue(start: number, end: number, p: number, ease?: "inExpo"): number {
    var delta: number = end - start;
    var easeFn: (p: number) => number = ease === "inExpo" ? easeInExpo : linear;
    return start + delta * easeFn(p);
  }

  function tweenDisc(disc: Disc): void {
    disc.x = tweenValue(state.startDisc.x, state.endDisc.x, disc.p);
    disc.y = tweenValue(state.startDisc.y, state.endDisc.y, disc.p, "inExpo");
    disc.w = tweenValue(state.startDisc.w, state.endDisc.w, disc.p);
    disc.h = tweenValue(state.startDisc.h, state.endDisc.h, disc.p);
  }

  function setSize(): void {
    var rect: DOMRect = canvas.getBoundingClientRect();
    state.rect = { width: rect.width, height: rect.height };
    state.render = {
      width: rect.width,
      height: rect.height,
      dpi: window.devicePixelRatio || 1,
    };
    canvas.width = Math.max(1, state.render.width * state.render.dpi);
    canvas.height = Math.max(1, state.render.height * state.render.dpi);
  }

  function setDiscs(): void {
    var width: number = state.rect.width;
    var height: number = state.rect.height;
    if (!width || !height) return;
    state.discs = [];
    
    // Use consistent aspect ratio for mobile to match desktop perspective
    var aspectRatio: number = width / height;
    var isPortrait: boolean = aspectRatio < 1;
    var baseWidth: number = isPortrait ? height * 1.5 : width;
    var baseHeight: number = isPortrait ? height : width / 1.5;
    
    state.startDisc = {
      p: 0,
      x: width * 0.5,
      y: isPortrait ? height * 0.66 : height * 0.55,
      w: baseWidth * 0.75,
      h: baseHeight * 0.7,
    };
    state.endDisc = {
      p: 0,
      x: width * 0.5,
      y: height * 0.95,
      w: 0,
      h: 0,
    };
    var prevBottom: number = height;
    state.clip = {};
    for (var i: number = 0; i < discsCount; i++) {
      var p: number = i / discsCount;
      var disc: Disc = { p: p, x: 0, y: 0, w: 0, h: 0 };
      tweenDisc(disc);
      var bottom: number = disc.y + disc.h;
      if (bottom <= prevBottom) {
        state.clip = {
          disc: { x: disc.x, y: disc.y, w: disc.w, h: disc.h, p: disc.p },
          i: i,
        };
      }
      prevBottom = bottom;
      state.discs.push(disc);
    }
    var clipPath: Path2D = new Path2D();
    var disc: Disc = state.clip.disc!;
    clipPath.ellipse(disc.x, disc.y, disc.w, disc.h, 0, 0, Math.PI * 2);
    clipPath.rect(disc.x - disc.w, 0, disc.w * 2, disc.y);
    state.clip.path = clipPath;
  }

  function setLines(): void {
    var width: number = state.rect.width;
    var height: number = state.rect.height;
    if (!width || !height) return;
    state.lines = [];
    var linesAngle: number = (Math.PI * 2) / linesCount;
    for (var i: number = 0; i < linesCount; i++) {
      state.lines.push([]);
    }
    state.discs.forEach(function (disc: Disc, _index: number): void {
      for (var i: number = 0; i < linesCount; i++) {
        var angle: number = i * linesAngle;
        var p: Point = {
          x: disc.x + Math.cos(angle) * disc.w,
          y: disc.y + Math.sin(angle) * disc.h,
        };
        state.lines[i].push(p);
      }
    });

    var dpi: number = state.render.dpi || 1;
    var offCanvas: HTMLCanvasElement = document.createElement("canvas");
    offCanvas.width = Math.max(1, Math.round(width * dpi));
    offCanvas.height = Math.max(1, Math.round(height * dpi));
    var offCtx: CanvasRenderingContext2D | null = offCanvas.getContext("2d");
    if (!offCtx) return;
    var clipPath: Path2D = state.clip.path!;

    offCtx.lineWidth = 1;
    var enters: number[] = state.lines.map(function (line: Point[], _index: number): number {
      for (var j: number = 1; j < line.length; j++) {
        var p: Point = line[j];
        if (
          offCtx!.isPointInPath(clipPath, p.x, p.y) ||
          offCtx!.isPointInStroke(clipPath, p.x, p.y)
        ) {
          return j;
        }
      }
      return -1;
    });

    offCtx.scale(dpi, dpi);
    offCtx.strokeStyle = strokeColor;
    offCtx.lineWidth = lineWidth;
    offCtx.lineJoin = "round";
    offCtx.lineCap = "round";

    function strokePolyline(points: Point[]): void {
      if (points.length < 2) return;
      offCtx!.beginPath();
      offCtx!.moveTo(points[0].x, points[0].y);
      for (var j: number = 1; j < points.length; j++) {
        offCtx!.lineTo(points[j].x, points[j].y);
      }
      offCtx!.stroke();
    }

    state.lines.forEach(function (line: Point[], i: number): void {
      var enter: number = enters[i];
      if (enter === -1) {
        strokePolyline(line);
        return;
      }
      strokePolyline(line.slice(0, enter + 1));
      offCtx!.save();
      offCtx!.clip(clipPath);
      strokePolyline(line.slice(enter));
      offCtx!.restore();
    });
    state.linesCanvas = offCanvas;
  }

  function initParticle(start?: boolean): Particle {
    start = start || false;
    var sx: number = state.particleArea.sx + state.particleArea.sw * Math.random();
    var ex: number = state.particleArea.ex + state.particleArea.ew * Math.random();
    var dx: number = ex - sx;
    var y: number = start ? state.particleArea.h * Math.random() : state.particleArea.h;
    var r: number = 0.5 + Math.random() * 4;
    var vy: number = 0.5 + Math.random();
    return {
      x: sx,
      sx: sx,
      dx: dx,
      y: y,
      vy: vy,
      p: 0,
      r: r,
      c:
        "rgba(" +
        particleRGB[0] +
        "," +
        particleRGB[1] +
        "," +
        particleRGB[2] +
        "," +
        Math.random() +
        ")",
    };
  }

  function setParticles(): void {
    var width: number = state.rect.width;
    var height: number = state.rect.height;
    state.particles = [];
    if (!particlesEnabled || !width || !height || !state.clip.disc) return;
    state.particleArea = {
      sw: state.clip.disc.w * 0.5,
      ew: state.clip.disc.w * 2,
      h: height * 0.85,
      sx: 0,
      ex: 0,
    };
    state.particleArea.sx = (width - state.particleArea.sw) / 2;
    state.particleArea.ex = (width - state.particleArea.ew) / 2;
    for (var i: number = 0; i < particleCount; i++) {
      state.particles.push(initParticle(true));
    }
  }

  function drawDiscs(): void {
    ctx!.strokeStyle = strokeColor;
    ctx!.lineWidth = lineWidth;
    var outerDisc: Disc = state.startDisc;
    ctx!.beginPath();
    ctx!.ellipse(
      outerDisc.x,
      outerDisc.y,
      outerDisc.w,
      outerDisc.h,
      0,
      0,
      Math.PI * 2
    );
    ctx!.stroke();
    ctx!.closePath();
    state.discs.forEach(function (disc: Disc, i: number): void {
      if (i % 5 !== 0) return;
      if (disc.w < state.clip.disc!.w - 5) {
        ctx!.save();
        ctx!.clip(state.clip.path!);
      }
      ctx!.beginPath();
      ctx!.ellipse(disc.x, disc.y, disc.w, disc.h, 0, 0, Math.PI * 2);
      ctx!.stroke();
      ctx!.closePath();
      if (disc.w < state.clip.disc!.w - 5) {
        ctx!.restore();
      }
    });
  }

  function drawLines(): void {
    var off: HTMLCanvasElement | null = state.linesCanvas;
    if (!off) return;
    var width: number = state.rect.width;
    var height: number = state.rect.height;
    ctx!.drawImage(off, 0, 0, width, height);
  }

  function drawParticles(): void {
    if (!state.clip.path) return;
    ctx!.save();
    ctx!.clip(state.clip.path);
    state.particles.forEach(function (particle: Particle, _index: number): void {
      ctx!.fillStyle = particle.c;
      ctx!.beginPath();
      ctx!.arc(
        particle.x + particle.r / 2,
        particle.y + particle.r / 2,
        particle.r / 2,
        0,
        Math.PI * 2
      );
      ctx!.closePath();
      ctx!.fill();
    });
    ctx!.restore();
  }

  function moveDiscs(): void {
    state.discs.forEach(function (disc: Disc, _index: number): void {
      disc.p = (disc.p + discInc) % 1;
      tweenDisc(disc);
    });
  }

  function moveParticles(): void {
    state.particles.forEach(function (particle: Particle, idx: number): void {
      particle.p = 1 - particle.y / state.particleArea.h;
      particle.x = particle.sx + particle.dx * particle.p;
      particle.y -= particle.vy * vyScale;
      if (particle.y < 0) {
        state.particles[idx] = initParticle(false);
      }
    });
  }

  var animationFrameId: number;

  function tick(): void {
    ctx!.clearRect(0, 0, canvas.width, canvas.height);
    ctx!.save();
    ctx!.scale(state.render.dpi, state.render.dpi);
    if (state.clip.path) {
      moveDiscs();
      moveParticles();
      drawDiscs();
      drawLines();
      drawParticles();
    }
    ctx!.restore();
    animationFrameId = requestAnimationFrame(tick);
  }

  function init(): void {
    setSize();
    setDiscs();
    setLines();
    setParticles();
  }

  function boot(): void {
    init();
    tick();
    var ro: ResizeObserver = new ResizeObserver(function (_entries: ResizeObserverEntry[]): void {
      setSize();
      setDiscs();
      setLines();
      setParticles();
    });
    ro.observe(canvas.parentElement!);
    (canvas as any)._ro = ro;
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", boot);
  } else {
    boot();
  }
})();
</script>
