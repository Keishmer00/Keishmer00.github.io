---
// Proyectos destacados (spec 008): un panel a pantalla completa por marca, recorrido con
// scroll horizontal. Sustituye a Works.astro en la home (Works se conserva sin montar).
//
// Mecánica: sin JS (o con prefers-reduced-motion) el contenedor [data-viewport] es un
// carrusel horizontal nativo con scroll-snap. Con JS, GSAP ScrollTrigger fija la sección
// (pin) y convierte el scroll vertical en desplazamiento horizontal del track, con snap.
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";
import { getFeaturedProjects, getFeaturedProjectUrl } from "../lib/featured";

export interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { t } = useTranslations(lang);

const projects = getFeaturedProjects(lang).map((project) => ({
  ...project,
  href: getFeaturedProjectUrl(project.id, lang),
}));

const count = projects.length;
const pad = (n: number) => String(n).padStart(2, "0");
---

<featured-projects
  id="featured-projects"
  class="relative block w-full bg-surface-page text-text-primary selection:bg-surface-primary selection:text-text-on-primary"
  style={`--featured-count: ${count};`}
  data-count={count}
>
  <!-- [data-pin] es lo que ScrollTrigger fija: cabecera + carrusel + barra de progreso juntos -->
  <div data-pin class="relative h-svh w-full lg:h-screen">
    <!-- Cabecera fija: eyebrow + contador (no roba altura a los paneles) -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-30 flex items-center justify-between px-6 pt-16 md:px-8 md:pt-20 lg:px-16 xl:px-24"
    >
      <p
        class="flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-text-secondary [text-shadow:0_1px_12px_rgba(0,0,0,0.8)] light:text-text-primary light:font-bold light:[text-shadow:none] md:text-sm"
      >
        <span class="h-2 w-2 rounded-full bg-primary" aria-hidden="true"></span>
        {t("featured.eyebrow")}
      </p>
      <p
        class="font-mono text-xs uppercase tracking-widest text-text-secondary [text-shadow:0_1px_12px_rgba(0,0,0,0.8)] light:text-text-primary light:font-bold light:[text-shadow:none] md:text-sm"
        aria-hidden="true"
      >
        <span data-counter-current class="text-text-primary">{pad(1)}</span>
        <span class="mx-1 text-text-muted">/</span>
        <span>{pad(count)}</span>
      </p>
    </div>

    <!-- Carrusel: sin JS / reduced-motion hace scroll horizontal nativo con snap -->
    <div
      data-viewport
      role="region"
      aria-label={t("featured.regionLabel")}
      tabindex="0"
      class="featured-viewport relative h-full w-full"
    >
      <!-- Track horizontal: n paneles de 100 % cada uno -->
      <div data-track class="featured-track flex h-full">
        {
          projects.map((project, index) => (
            <article
              data-panel
              data-active={index === 0 ? "true" : "false"}
              data-project={project.id}
              aria-label={`${t("featured.counterLabel")} ${pad(index + 1)} — ${project.brand}`}
              class="featured-panel relative flex h-full flex-col overflow-hidden lg:flex-row"
            >
              {/* Logo de la marca. Mobile: en el flujo, centrado en el espacio libre sobre el texto (nunca choca con un título largo). Desktop: centrado sobre la imagen (mitad derecha). */}
              <div class="pointer-events-none relative z-10 flex flex-1 items-center justify-center px-10 pt-24 lg:absolute lg:inset-y-0 lg:left-1/2 lg:w-1/2 lg:flex-none lg:p-0">
                <img
                  data-logo
                  src={project.logo.src}
                  alt={project.logoAlt}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="h-auto max-h-20 w-[56%] max-w-[240px] object-contain brightness-0 invert drop-shadow-[0_2px_24px_rgba(0,0,0,0.65)] light:invert-0 light:drop-shadow-none lg:max-h-36 lg:w-[48%] lg:max-w-sm"
                />
              </div>

              {/* Columna izquierda (desktop) / bloque inferior (mobile): la historia */}
              <div
                data-copy
                class="relative z-10 mt-auto flex flex-col gap-4 px-6 pb-10 pt-6 md:px-8 md:pb-14 lg:mt-0 lg:h-full lg:w-1/2 lg:justify-center lg:gap-6 lg:bg-surface-page lg:px-16 lg:py-24 xl:px-24"
              >
                <p class="font-mono text-sm uppercase tracking-widest text-text-secondary md:text-base">
                  <span class="text-primary">{pad(index + 1)}</span>
                  <span class="mx-2 text-text-muted" aria-hidden="true">
                    —
                  </span>
                  <span class="text-text-primary">{project.brand}</span>
                  <span class="mx-2 text-text-muted" aria-hidden="true">
                    ·
                  </span>
                  <span>{project.year}</span>
                </p>

                <h3 class="max-w-2xl font-unbounded text-2xl font-bold uppercase leading-tight text-text-primary md:text-3xl 2xl:text-4xl">
                  {project.title}
                </h3>

                <p class="max-w-xl font-albert text-base leading-relaxed text-text-primary max-lg:line-clamp-4 md:text-lg">
                  {project.description}
                </p>

                <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-4">
                  <p class="shrink-0 font-mono text-xs uppercase tracking-widest text-text-muted">
                    {t("featured.stagesLabel")}
                  </p>
                  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs uppercase tracking-wider text-text-secondary md:text-sm">
                    {project.stages.map((stage, stageIndex) => (
                      <li class="flex items-center gap-2">
                        {stageIndex > 0 && (
                          <span class="text-text-muted" aria-hidden="true">
                            →
                          </span>
                        )}
                        <span>{t(`featured.stages.${stage.id}`)}</span>
                      </li>
                    ))}
                  </ol>
                </div>

                {/* CTA (mobile): bajo el texto, porque la imagen es todo el panel */}
                <a
                  href={project.href}
                  data-analytics-event="case_study_click"
                  data-analytics-label={project.id}
                  class="group mt-2 inline-flex w-fit items-center gap-2 border border-border-strong px-4 py-3 font-mono text-base text-text-primary transition-colors duration-300 hover:border-primary hover:text-primary lg:hidden"
                >
                  <span>{t("featured.cta")}</span>
                  <span
                    class="transition-transform duration-300 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </div>

              {/* Imagen: todo el panel en mobile; todo el alto y medio ancho en desktop.
                  En desktop arranca 2px bajo la columna de texto (z-10): durante el scroll
                  horizontal el borde cae en posiciones subpíxel y, si coincide con el de la
                  columna, se cuela una línea de la foto (muy visible en modo claro).
                  Sin `isolate`: un contenedor que aísla + recorta una foto movida en 3D
                  (parallax) pintaba una línea negra de 1px en su borde durante el scroll,
                  sobre todo en pantallas de densidad fraccionaria (Android 2.625×). El orden
                  de capas es explícito: foto z-0, velo z-[1], CTA z-10. */}
              <div
                data-media
                class="group absolute inset-0 overflow-hidden lg:left-[calc(50%-2px)] lg:h-full lg:w-[calc(50%+2px)]"
              >
                <img
                  data-image
                  src={project.image.src}
                  alt={project.imageAlt}
                  width={project.image.width}
                  height={project.image.height}
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="absolute inset-0 z-0 h-full w-full object-cover grayscale transition-[filter] duration-700 ease-out group-hover:grayscale-0"
                />
                {/* Velo: legibilidad del texto (mobile) y fusión con la columna negra (desktop) */}
                <div
                  class="pointer-events-none absolute inset-0 z-[1] bg-linear-to-t from-surface-page via-surface-page/60 to-surface-page/20 max-lg:light:via-surface-page/85 max-lg:light:to-surface-page/45 lg:bg-linear-to-r lg:from-surface-page lg:via-surface-page/35 lg:to-surface-page/25"
                  aria-hidden="true"
                />

                {/* CTA (desktop): esquina inferior izquierda de la imagen */}
                <a
                  href={project.href}
                  data-analytics-event="case_study_click"
                  data-analytics-label={project.id}
                  class="group/cta absolute bottom-10 left-10 z-10 hidden items-center gap-2 border border-border-strong bg-surface-page/40 px-5 py-3 font-mono text-lg text-text-primary backdrop-blur-sm transition-colors duration-300 hover:border-primary hover:text-primary lg:inline-flex xl:bottom-12 xl:left-12"
                >
                  <span>{t("featured.cta")}</span>
                  <span
                    class="transition-transform duration-300 group-hover/cta:-translate-y-0.5 group-hover/cta:translate-x-0.5"
                    aria-hidden="true"
                  >
                    ↗
                  </span>
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- Barra de progreso -->
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-30 h-px bg-border-subtle"
      aria-hidden="true"
    >
      <div
        data-progress
        class="h-full w-full origin-left bg-primary"
        style="transform: scaleX(0);"
      >
      </div>
    </div>
  </div>
</featured-projects>

<style>
  featured-projects {
    display: block;
  }

  /* Estado base (sin JS o con prefers-reduced-motion): carrusel horizontal nativo con snap */
  .featured-viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .featured-viewport::-webkit-scrollbar {
    display: none;
  }
  .featured-viewport:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .featured-panel + .featured-panel {
    margin-left: -2px;
  }

  /* Estado con GSAP: el track lo mueve ScrollTrigger; el contenedor deja de hacer scroll */
  .featured-viewport.is-pinned {
    overflow: hidden;
    scroll-snap-type: none;
  }

  .featured-track {
    width: calc(100% * var(--featured-count, 1));
    will-change: transform;
  }

  /* Cada panel mide 2px más y se monta 2px sobre el anterior (que queda debajo):
     el borde entre proyectos cae siempre sobre la foto vecina y no sobre un fondo
     vacío. Con densidades fraccionarias (Android 2.625×/2.75×: un ancho de pantalla
     no es un número entero de píxeles físicos) ese borde cae en parte de un píxel y
     aparecía una línea vertical durante el scroll horizontal. El inicio de cada panel
     sigue siendo i × ancho de pantalla, así que el snap no cambia (spec 008/010). */
  .featured-panel {
    width: calc(100% / var(--featured-count, 1) + 2px);
    flex: 0 0 auto;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  class FeaturedProjects extends HTMLElement {
    private cleanup: (() => void) | null = null;

    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      const pinTarget = this.querySelector<HTMLElement>("[data-pin]");
      const viewport = this.querySelector<HTMLElement>("[data-viewport]");
      const track = this.querySelector<HTMLElement>("[data-track]");
      const panels = Array.from(
        this.querySelectorAll<HTMLElement>("[data-panel]"),
      );
      const counter = this.querySelector<HTMLElement>("[data-counter-current]");
      const progressBar = this.querySelector<HTMLElement>("[data-progress]");

      if (!pinTarget || !viewport || !track || panels.length < 2) return;

      const total = panels.length;
      const pad = (n: number) => String(n).padStart(2, "0");

      let activeIndex = -1;
      const setActive = (index: number) => {
        const next = Math.min(total - 1, Math.max(0, index));
        if (next === activeIndex) return;
        activeIndex = next;
        panels.forEach((panel, i) => {
          panel.dataset.active = i === next ? "true" : "false";
        });
        if (counter) counter.textContent = pad(next + 1);
      };
      const setProgress = (progress: number) => {
        if (progressBar) progressBar.style.transform = `scaleX(${progress})`;
      };

      gsap.registerPlugin(ScrollTrigger);
      // El colapso de la barra de direcciones en mobile no debe refrescar el pin.
      ScrollTrigger.config({ ignoreMobileResize: true });

      const mm = gsap.matchMedia();

      // ─── Modo pinned: scroll vertical → desplazamiento horizontal con snap ───
      mm.add("(prefers-reduced-motion: no-preference)", () => {
        viewport.classList.add("is-pinned");
        viewport.removeAttribute("tabindex");
        viewport.scrollLeft = 0;

        // Paso exacto de un panel = ancho del viewport (el solape de 2px no cuenta).
        const distance = () => viewport.clientWidth * (total - 1);

        // El desplazamiento se redondea a píxeles físicos: cada panel mide un ancho de
        // pantalla exacto, así sus bordes caen siempre en un píxel entero. Con valores
        // fraccionarios (p. ej. -555.39px) el borde entre paneles se mezclaba con el
        // fondo y aparecía una línea vertical de 1px durante el scroll (spec 010).
        const snapToDevicePixel = gsap.utils.unitize((value: number) => {
          const dpr = window.devicePixelRatio || 1;
          return Math.round(value * dpr) / dpr;
        });

        const horizontal = gsap.to(track, {
          x: () => -distance(),
          ease: "none",
          modifiers: { x: snapToDevicePixel },
          scrollTrigger: {
            // Se fija [data-pin] (cabecera + carrusel + barra), no el custom element:
            // ScrollTrigger envuelve el elemento fijado en un pin-spacer y, si fuera
            // <featured-projects>, ese re-parenting dispararía disconnected/connectedCallback en bucle.
            trigger: pinTarget,
            pin: pinTarget,
            start: "top top",
            end: () => "+=" + distance(),
            scrub: 1,
            anticipatePin: 1,
            invalidateOnRefresh: true,
            snap: {
              snapTo: 1 / (total - 1),
              duration: { min: 0.2, max: 0.6 },
              delay: 0.05,
              ease: "power1.inOut",
              directional: true,
              inertia: false, // sin predicción por velocidad: nunca se salta un panel
            },
            onUpdate: (self) => {
              setActive(Math.round(self.progress * (total - 1)));
              setProgress(self.progress);
            },
          },
        });

        panels.forEach((panel, index) => {
          const copy = panel.querySelectorAll<HTMLElement>("[data-copy] > *");
          const image = panel.querySelector<HTMLElement>("[data-image]");
          const logo = panel.querySelector<HTMLElement>("[data-logo]");

          if (index === 0) {
            // El primer panel entra cuando la sección llega, como el resto de secciones de la home.
            gsap.from(copy, {
              y: 28,
              opacity: 0,
              duration: 0.8,
              stagger: 0.08,
              ease: "power3.out",
              scrollTrigger: {
                trigger: pinTarget,
                start: "top 75%",
                toggleActions: "play none none none",
              },
            });
          } else {
            // Los demás entran a medida que su panel se desliza hacia el centro.
            gsap.from(copy, {
              y: 28,
              opacity: 0,
              stagger: 0.06,
              ease: "power2.out",
              scrollTrigger: {
                trigger: panel,
                containerAnimation: horizontal,
                start: "left 70%",
                end: "left 25%",
                scrub: true,
              },
            });
            if (logo) {
              gsap.from(logo, {
                scale: 0.85,
                opacity: 0,
                ease: "power2.out",
                scrollTrigger: {
                  trigger: panel,
                  containerAnimation: horizontal,
                  start: "left 80%",
                  end: "left 35%",
                  scrub: true,
                },
              });
            }
          }

          // Parallax horizontal leve de la imagen (escalada para no descubrir bordes).
          // Solo en desktop: en mobile/tablet la foto movida en 3D dentro del panel
          // pintaba una línea vertical de 1px entre proyectos durante el scroll
          // (sobre todo con densidades fraccionarias, p. ej. Android 2.625×).
          if (image && window.matchMedia("(min-width: 1024px)").matches) {
            gsap.set(image, { scale: 1.12 });
            gsap.fromTo(
              image,
              { xPercent: -5 },
              {
                xPercent: 5,
                ease: "none",
                scrollTrigger: {
                  trigger: panel,
                  containerAnimation: horizontal,
                  start: "left right",
                  end: "right left",
                  scrub: true,
                },
              },
            );
          }
        });

        // Teclado: al enfocar un CTA de un panel fuera de vista, el navegador desplaza el
        // contenedor `overflow: hidden` (rompería el track). Se deshace y se lleva la ventana
        // al punto de scroll de ese panel, que es lo que mueve el track en este modo.
        const onFocusIn = (event: FocusEvent) => {
          const panel = (
            event.target as HTMLElement | null
          )?.closest<HTMLElement>("[data-panel]");
          if (!panel) return;
          viewport.scrollLeft = 0;
          const trigger = horizontal.scrollTrigger;
          if (!trigger) return;
          const index = panels.indexOf(panel);
          const top =
            trigger.start +
            (trigger.end - trigger.start) * (index / (total - 1));
          window.scrollTo({ top, behavior: "smooth" });
        };
        const onViewportScroll = () => {
          if (viewport.scrollLeft !== 0) viewport.scrollLeft = 0;
        };
        viewport.addEventListener("focusin", onFocusIn);
        viewport.addEventListener("scroll", onViewportScroll, {
          passive: true,
        });

        setActive(0);
        setProgress(0);

        return () => {
          viewport.removeEventListener("focusin", onFocusIn);
          viewport.removeEventListener("scroll", onViewportScroll);
          viewport.classList.remove("is-pinned");
          viewport.setAttribute("tabindex", "0");
        };
      });

      // ─── Modo reducido: carrusel nativo; solo se sincronizan contador y barra ───
      mm.add("(prefers-reduced-motion: reduce)", () => {
        const onScroll = () => {
          const width = viewport.clientWidth || 1;
          const max = Math.max(1, track.scrollWidth - width);
          setActive(Math.round(viewport.scrollLeft / width));
          setProgress(Math.min(1, viewport.scrollLeft / max));
        };
        viewport.addEventListener("scroll", onScroll, { passive: true });
        onScroll();
        return () => viewport.removeEventListener("scroll", onScroll);
      });

      // ─── Precarga de las imágenes de los paneles ocultos al acercarse la sección ───
      let warmObserver: IntersectionObserver | null = null;
      const warmImages = () => {
        this.querySelectorAll<HTMLImageElement>("img[loading='lazy']").forEach(
          (img) => {
            img.loading = "eager";
          },
        );
      };
      if ("IntersectionObserver" in window) {
        warmObserver = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            warmImages();
            warmObserver?.disconnect();
            warmObserver = null;
          },
          { rootMargin: "800px" },
        );
        warmObserver.observe(this);
      } else {
        warmImages();
      }

      this.cleanup = () => {
        warmObserver?.disconnect();
        warmObserver = null;
        mm.revert();
      };
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = null;
      delete this.dataset.initialized;
    }
  }

  if (!customElements.get("featured-projects")) {
    customElements.define("featured-projects", FeaturedProjects);
  }
</script>
