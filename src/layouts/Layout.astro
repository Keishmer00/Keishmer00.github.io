---
import SeoHead from "../components/SeoHead.astro";
import CursorParticles from "../components/CursorParticles.astro";
import Analytics from "../components/Analytics.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import type { Lang } from "../i18n/index";
import "../styles/global.css";

export interface Props {
  lang: Lang;
  page: "home" | "about-me" | "uxui" | "frontend" | "visualArtist" | "projects" | "contact" | "terms" | "privacy" | "error";
  pathname: string;
  title?: string;
  description?: string;
}

const { lang, page, pathname, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang === "en" ? "en" : "es"}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<!-- Favicon -->
		<link rel="icon" href="/favicon/favicon.ico" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<!-- Sitemap -->
		<link rel="sitemap" href="/sitemap-index.xml" />

		<SeoHead lang={lang} page={page} pathname={pathname} title={title} description={description} />

	</head>
	<body>
		<CursorParticles />
		<Analytics />
		<ConsentBanner lang={lang} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0 auto;
		width: 100%;
		height: 100%;
		box-sizing: border-box;
		overflow-x: hidden;
		font-family: var(--albert);
		color: var(--text-white);
	}
</style>
