---
// /projects/ (spec 008): lista los proyectos destacados de src/lib/featured.ts con su
// narrativa de proceso. El listado por categorías (spec 004) vive en
// components/ProjectsCatalog.astro y ya no se monta aquí.
import Footer from "../../components/Footer.astro";
import Navbar from "../../components/Navbar.astro";
import Breadcrumbs from "../../components/atoms/Breadcrumbs.astro";
import Layout from "../../layouts/Layout.astro";
import type { Lang } from "../../i18n/index";
import { getLocalizedPath, useTranslations } from "../../i18n/index";
import { getFeaturedProjects, getFeaturedProjectUrl } from "../../lib/featured";

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: undefined } }, { params: { lang: "es" } }];
}

const { lang = "en" } = Astro.params as { lang?: Lang };
const { t } = useTranslations(lang);
const pathname = lang === "en" ? "/projects/" : "/es/projects/";
const projects = getFeaturedProjects(lang).map((project) => ({
  ...project,
  href: getFeaturedProjectUrl(project.id, lang),
}));
const pad = (n: number) => String(n).padStart(2, "0");
---

<Layout lang={lang} page="projects" pathname={pathname}>
  <Navbar lang={lang} pathname={pathname} />
  <Breadcrumbs
    items={[
      {
        label: t("projects.breadcrumbHome"),
        href: getLocalizedPath("/", lang),
      },
      { label: t("projects.breadcrumbProjects") },
    ]}
    light
  />
  <main class="bg-surface-page px-4 pb-8 pt-32 md:px-8 lg:px-24 lg:pt-40">
    <section class="mx-auto mb-16 max-w-6xl">
      <h1
        class="font-unbounded text-3xl font-bold uppercase leading-tight text-text-primary md:text-5xl"
      >
        {t("projects.title")}
      </h1>
      <p class="mt-4 font-mono text-xs text-text-muted md:text-xl">
        {t("projects.description")}
      </p>
      <p
        class="mt-6 max-w-3xl font-albert text-base leading-relaxed text-text-secondary md:text-lg"
      >
        {t("featured.list.intro")}
      </p>
    </section>

    <projects-page id="projects-page" class="mx-auto flex max-w-6xl flex-col">
      <ol class="flex flex-col gap-16 lg:gap-24">
        {
          projects.map((project, index) => (
            <li>
              <article
                class="featured-item group grid gap-8 border-t border-border-subtle pt-8 lg:grid-cols-12 lg:gap-12 lg:pt-12"
                data-project={project.id}
              >
                <a
                  href={project.href}
                  aria-label={`${t("featured.cta")}: ${project.brand}`}
                  data-analytics-event="case_study_click"
                  data-analytics-label={project.id}
                  class={`relative isolate block aspect-4/3 overflow-hidden bg-secondary lg:col-span-5 lg:aspect-auto lg:min-h-105
                 ${index % 2 === 1 ? "lg:order-2" : ""}`}
                >
                  <img
                    src={project.image.src}
                    alt={project.imageAlt}
                    width={project.image.width}
                    height={project.image.height}
                    loading={index === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="absolute inset-0 -z-10 h-full w-full object-cover grayscale transition-[filter,transform] duration-700 ease-out group-hover:scale-105 group-hover:grayscale-0"
                  />
                  <div
                    class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/85 via-black/40 to-black/20"
                    aria-hidden="true"
                  />
                  <img
                    src={project.logo.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="absolute left-1/2 top-1/2 h-auto max-h-20 w-[48%] max-w-60 -translate-x-1/2 -translate-y-1/2 object-contain brightness-0 invert drop-shadow-[0_2px_24px_rgba(0,0,0,0.65)] lg:max-h-28"
                  />
                </a>

                <div
                  class={`flex flex-col gap-4 lg:col-span-7 lg:justify-center lg:gap-5 ${index % 2 === 1 ? "lg:order-1" : ""}`}
                >
                  <p class="font-mono text-sm uppercase tracking-widest text-text-secondary md:text-base">
                    <span class="text-text-accent">{pad(index + 1)}</span>
                    <span class="mx-2 text-text-muted" aria-hidden="true">
                      —
                    </span>
                    <span class="text-text-primary">{project.brand}</span>
                    <span class="mx-2 text-text-muted" aria-hidden="true">
                      ·
                    </span>
                    <span>{project.sector}</span>
                    <span class="mx-2 text-text-muted" aria-hidden="true">
                      ·
                    </span>
                    <span>{project.year}</span>
                  </p>

                  <h2 class="max-w-2xl font-unbounded text-2xl font-bold uppercase leading-tight text-text-primary md:text-3xl">
                    <a
                      href={project.href}
                      class="transition-colors hover:text-text-accent"
                    >
                      {project.title}
                    </a>
                  </h2>

                  <p class="max-w-2xl font-albert text-base leading-relaxed text-text-primary md:text-lg">
                    {project.description}
                  </p>

                  <div class="flex flex-col gap-2 md:flex-row md:items-baseline md:gap-4">
                    <p class="shrink-0 font-mono text-xs uppercase tracking-widest text-text-muted">
                      {t("featured.stagesLabel")}
                    </p>
                    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs uppercase tracking-wider text-text-secondary md:text-sm">
                      {project.stages.map((stage, stageIndex) => (
                        <li class="flex items-center gap-2">
                          {stageIndex > 0 && (
                            <span class="text-text-muted" aria-hidden="true">
                              →
                            </span>
                          )}
                          <span>{t(`featured.stages.${stage.id}`)}</span>
                        </li>
                      ))}
                    </ol>
                  </div>

                  <a
                    href={project.href}
                    data-analytics-event="case_study_click"
                    data-analytics-label={project.id}
                    class="group/cta mt-2 inline-flex w-fit items-center gap-2 border border-border-strong px-4 py-3 font-mono text-base text-text-primary transition-colors duration-300 hover:border-primary hover:text-text-accent"
                  >
                    <span>{t("featured.cta")}</span>
                    <span
                      class="transition-transform duration-300 group-hover/cta:-translate-y-0.5 group-hover/cta:translate-x-0.5"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </a>
                </div>
              </article>
            </li>
          ))
        }
      </ol>
    </projects-page>
  </main>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      itemListElement: projects.map((project, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: project.brand,
        url: `https://keishmerstudio.com${project.href}`,
        image: `https://keishmerstudio.com${project.image.src}`,
      })),
    })}
  />

  <Footer lang={lang} pathname={pathname} />
</Layout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  class ProjectsPage extends HTMLElement {
    private cleanup: (() => void) | null = null;

    connectedCallback() {
      if (this.dataset.initialized === "true") return;
      this.dataset.initialized = "true";

      const items = Array.from(
        this.querySelectorAll<HTMLElement>(".featured-item"),
      );
      if (!items.length) return;

      gsap.registerPlugin(ScrollTrigger);
      const mm = gsap.matchMedia();

      mm.add("(prefers-reduced-motion: no-preference)", () => {
        items.forEach((item) => {
          gsap.from(item.children, {
            y: 32,
            opacity: 0,
            duration: 0.7,
            stagger: 0.12,
            ease: "power3.out",
            scrollTrigger: {
              trigger: item,
              start: "top 88%",
              toggleActions: "play none none none",
            },
          });
        });
      });

      this.cleanup = () => mm.revert();
    }

    disconnectedCallback() {
      this.cleanup?.();
      this.cleanup = null;
      delete this.dataset.initialized;
    }
  }

  if (!customElements.get("projects-page")) {
    customElements.define("projects-page", ProjectsPage);
  }
</script>

<style>
  projects-page {
    display: block;
  }
</style>
