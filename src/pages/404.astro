---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Breadcrumbs from "../components/atoms/Breadcrumbs.astro";
import Footer from "../components/Footer.astro";
import type { Lang } from "../i18n/index";
import { useTranslations } from "../i18n/index";
import video404 from "../assets/videos/404.mp4";

const pathname = Astro.url.pathname;
const lang: Lang = pathname.startsWith("/es/") ? "es" : "en";
const { t } = useTranslations(lang);

Astro.response.status = 404;
---

<Layout lang={lang} page="error" pathname={pathname}>
    <Navbar lang={lang} pathname={pathname} />
    <Breadcrumbs
        items={[
            { label: t("projects.breadcrumbHome"), href: lang === "en" ? "/" : "/es/" },
            { label: "404" }
        ]}
        light
    />
    <main
        class="flex flex-col justify-end lg:pb-44 pb-24 h-svh items-center text-center p-4 w-full min-h-screen"
    >
        

        <p class="text-gray-300 text-2xl font-mono mb-10 max-w-lg">
            {t("error.message")}
        </p>
        <a
            href={lang === "en" ? "/" : "/es/"}
            class="inline-flex items-center justify-center gap-2 font-mono bg-black text-white px-8 py-3 border border-gray-300 font-medium text-2xl hover:bg-primary hover:text-black transition-colors"
        >
            {t("error.cta")}
        </a>
        <video src={video404} autoplay loop muted class="object-cover w-full h-full absolute inset-0 -z-10"></video>
    </main>
</Layout>
